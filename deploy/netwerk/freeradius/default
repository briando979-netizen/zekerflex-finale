# Het buitenste verzoek van de wifi-apparatuur van een klant. Bijna altijd EAP
# (WPA2/WPA3-Enterprise, PEAP): de echte controle gebeurt dan in de binnentunnel
# (sites-available/inner-tunnel). Een gewoon PAP-verzoek (radtest, een captive
# portal) vraagt het hier direct aan de app. Geen accounting, geen proxy. Alleen
# IPv4: met een IPv6-luisteraar erbij komt IPv4-verkeer als ::ffff:… binnen en
# blijft Packet-Src-IP-Address leeg, zodat de dynamic client geen IP krijgt.
server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 30
		}
	}

	authorize {
		filter_username
		preprocess
		eap {
			ok = return
		}
		zf_toegang
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		eap
	}

	preacct {
		preprocess
	}

	accounting {
		ok
	}

	session {
	}

	post-auth {
		update {
			&reply: += &session-state:
		}
		Post-Auth-Type REJECT {
			attr_filter.access_reject
			eap
		}
	}

	pre-proxy {
	}

	post-proxy {
	}
}
