# docker-mailserver configuratie — kopieer naar `mailserver.env` en pas aan.
# Volledige referentie: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# Je mail-hostname (moet matchen met 'hostname:' in docker-compose.yml en met je PTR/reverse-DNS)
OVERRIDE_HOSTNAME=mail.jouwdomein.nl
POSTMASTER_ADDRESS=postmaster@jouwdomein.nl

# Protocollen: IMAP (993) en POP3 (995) ophalen
ENABLE_IMAP=1
ENABLE_POP3=1

# TLS: 'letsencrypt' gebruikt certs die je met Caddy/certbot vernieuwt en in de
# container mount (zie README). Voor een eerste test mag 'self-signed' (onveilig).
SSL_TYPE=letsencrypt

# Mail-authenticiteit (cruciaal voor aflevering — zet de DKIM-TXT in je DNS-zone)
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_SPF=1

# Spam + beveiliging
ENABLE_RSPAMD=1
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1

# Overig
POSTFIX_INET_PROTOCOLS=ipv4
LOG_LEVEL=info
