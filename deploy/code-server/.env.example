# Kopieer naar `.env` en pas aan. Deze waarden zijn GEHEIM — niet committen.

# Je domein; de stack serveert code.<DOMAIN> en term.<DOMAIN>.
DOMAIN=jouwdomein.nl

# Login-wachtwoord voor VS Code (code-server). Maak dit lang en uniek.
PASSWORD=zet-hier-een-sterk-wachtwoord

# Basicauth voor de web-terminal (extra laag vóór ttyd).
TTYD_USER=admin
# Genereer de hash (NIET het platte wachtwoord hier):
#   docker run --rm caddy:2.8 caddy hash-password --plaintext 'jouwwachtwoord'
TTYD_PASS_HASH=$2a$14$vervang-dit-door-de-echte-hash
