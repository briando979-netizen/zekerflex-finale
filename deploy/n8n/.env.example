# Domain for n8n (DNS A-record → this server), e.g. n8n.zekerflex.com
N8N_HOST=n8n.example.com
# Long random string: openssl rand -hex 32  (keep it — n8n encrypts credentials with it)
N8N_ENCRYPTION_KEY=
# ZekerFlex API key with scope "brain:ask" (Admin → API-sleutels, or Werkgever → Integraties)
ZEKERFLEX_API_KEY=zf_live_
ZEKERFLEX_BASE_URL=https://zekerflex.com
# Secret of your ZekerFlex webhook subscription (to verify x-zekerflex-signature)
ZEKERFLEX_WEBHOOK_SECRET=

# Optional, for the example workflows
SLACK_WEBHOOK_URL=
BRIEFING_FROM=
BRIEFING_TO=
