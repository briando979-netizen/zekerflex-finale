# Kopieer naar `.env` (op de VPS). GEHEIM — niet committen.

# Je domein; de tunnel serveert <sub>.<DOMAIN> (bv. image.<DOMAIN>).
DOMAIN=jouwdomein.nl

# Gedeeld tunnel-token (sterk!). Zet HETZELFDE token in frpc.toml op je box.
#   genereer: openssl rand -base64 32
FRP_TOKEN=

# Optioneel: pin een specifieke frp-image i.p.v. latest, bv. snowdreamtech/frps:0.61.0
# FRP_IMAGE=snowdreamtech/frps
