# ZekerFlex — reverse proxy voor een VPS met eigen publiek IP (TransIP e.d.).
# Dit is het alternatief voor de Cloudflare-tunnel in docker-compose.prod.yml:
# hier komt verkeer rechtstreeks binnen op poort 80/443 van de VPS.
#
# SITE_ADDRESS (uit .env.production) bepaalt of er TLS is:
#   :80            platte HTTP (standaard) — gebruik dit zolang het domein nog
#                  ergens anders heen wijst; de site is dan bereikbaar op het IP.
#   zekerflex.com  Caddy haalt automatisch een Let's Encrypt-certificaat op en
#                  forceert HTTPS. Zet dit pas zodra de A-record van het domein
#                  naar deze VPS wijst, en herstart caddy.
#
# TLS werkt zonder e-mailadres (Caddy gebruikt dan Let's Encrypt zonder account-
# mail). Wil je verloopmeldingen? Voeg dan zelf een globale `email ...`-regel toe.

# Klantdomeinen (websites die bedrijven met ZekerFlex bouwen, lib/sites/domain.ts)
# krijgen hun certificaat op aanvraag, bij het eerste bezoek, en alleen als de app
# het domein kent: gekoppeld, eigendom bewezen met een TXT-regel en de website
# gepubliceerd. Zo kan niemand onze server certificaten laten halen voor andere namen.
{
	on_demand_tls {
		ask http://app:3000/api/sites/domein-check
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# www en het kale domein delen geen cookies. Wie op www inlogt krijgt de sessie
	# op www, wordt daarna naar AUTH_URL (zonder www) gestuurd en lijkt dan uitgelogd.
	# Daarom gaan pagina's altijd naar één adres. /api/* blijft buiten de redirect:
	# webhooks volgen geen redirects en clients met een Authorization-header (Laptop-
	# Jarvis, AI-node, partner-API) raken die kwijt bij een overstap naar een andere host.
	@www {
		host www.zekerflex.com
		not path /api/* /.well-known/*
	}
	# Definitief (308): het kale domein is het hoofdadres. Browsers en zoekmachines
	# leggen dit vast, en de methode blijft behouden.
	redir @www https://zekerflex.com{uri} 308

	# Next.js standalone server draait in de app-container op poort 3000.
	# X-ZF-Site-Host zet alleen het blok voor klantdomeinen hieronder. Hier halen we
	# hem weg, zodat niemand via zekerflex.com een klantwebsite kan laten tonen.
	reverse_proxy app:3000 {
		header_up -X-ZF-Site-Host
		header_up -X-ZF-Voorstel
		# Bij een uitrol is de app een paar seconden weg (nieuwe container). Lukt de
		# verbinding niet, probeer dan tot 15 s opnieuw in plaats van meteen een 502:
		# de bezoeker merkt een korte vertraging. Alleen bij een mislukte verbinding,
		# dus het verzoek was nog niet bij de app (ook een POST is dan veilig).
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# Ontwerpvoorstel voor Het Schwarzwald op een eigen subdomein. Een vaste naam,
# dus Caddy haalt het certificaat gewoon zelf op (DNS: A/AAAA naar deze VPS).
# Met X-ZF-Voorstel toont de middleware hier alleen het voorstel (voorstelSite).
schwarzwald.zekerflex.com {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up -X-ZF-Site-Host
		header_up X-ZF-Voorstel schwarzwald
		# uitrol: opnieuw verbinden in plaats van een 502 (zie het eerste blok)
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# Live voorbeeld van de Bouwer (Admin → ZekerFlex AI → Bouwer): next dev op de
# werkkopie, met alleen demogegevens. De bouwer-container laat alleen bezoekers
# met een getekende link uit Admin binnen (deploy/bouwer/werker/voorbeeld.mjs).
# Standaard een sslip.io-naam (geen DNS nodig); met een eigen A-record kan
# BOUWER_VOORBEELD_HOST in .env.production bv. voorbeeld.zekerflex.com worden.
{$BOUWER_VOORBEELD_HOST:voorbeeld.37-97-226-24.sslip.io} {
	encode zstd gzip
	# zoals overal: alleen hun eigen blokken zetten de koppen voor voorstel/klantsite
	reverse_proxy bouwer:4200 {
		header_up -X-ZF-Site-Host
		header_up -X-ZF-Voorstel
	}
}

# De VPN-server (Headscale, deploy/netwerk/headscale): de Tailscale-apps van
# klanten melden zich hier. Een vaste naam, dus Caddy haalt het certificaat zelf
# (DNS: A-record vpn.zekerflex.com → deze VPS; Admin → Te doen). De koppen voor
# klantsite en voorstel gaan hier weg, zoals in elk blok.
vpn.zekerflex.com {
	encode zstd gzip
	reverse_proxy headscale:8080 {
		header_up -X-ZF-Site-Host
		header_up -X-ZF-Voorstel
	}
}

# Rapportages: Metabase (lib/bi) op een eigen naam. Standaard een sslip.io-naam
# (geen DNS nodig); met een A-record kan METABASE_HOST in .env.production
# bi.zekerflex.com worden. Metabase heeft zijn eigen login; de ingebedde
# dashboards in /werkgever/rapportages gaan via getekende links.
{$METABASE_HOST:bi.37-97-226-24.sslip.io} {
	encode zstd gzip
	reverse_proxy metabase:3000 {
		header_up -X-ZF-Site-Host
		header_up -X-ZF-Voorstel
	}
}

# Websites van klanten op hun eigen domein. Alles op zo'n domein gaat naar die
# website en nooit naar de app zelf: met deze kop stuurt de middleware het
# verzoek naar /site-domein/<domein>/… (middleware.ts, customerSite).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-ZF-Site-Host {host}
		header_up -X-ZF-Voorstel
		# uitrol: opnieuw verbinden in plaats van een 502 (zie het eerste blok)
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}
