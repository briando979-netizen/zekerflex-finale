# ==========================================================================
# ZekerFlex Sovereign Box — production environment
#
#   cp deploy/.env.production.example .env.production
#   # fill in the REQUIRED block, generate the secrets, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# See docs/ENVIRONMENT.md for every variable. Anything not listed here keeps
# its safe built-in default (lib/env.ts).
# ==========================================================================

# ---- REQUIRED -------------------------------------------------------------

NODE_ENV=production

# Your public domain (the Cloudflare Tunnel hostname). Used for links in
# e-mails, OAuth redirects, KYC callbacks, VAPID audience, etc.
APP_BASE_URL=https://app.jouwdomein.com
AUTH_URL=https://app.jouwdomein.com
AUTH_TRUST_HOST=true

# 32+ random chars — `openssl rand -base64 48` or `npm run gen:secrets`.
AUTH_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS

# Shared secret for the internal cron/worker endpoints (16+ chars).
INTERNAL_CRON_TOKEN=CHANGE_ME_16_PLUS_RANDOM_CHARS

# Datastores. With docker-compose.prod.yml the app reaches these by service
# name; set POSTGRES_PASSWORD and the compose file builds DATABASE_URL for you.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://zekerflex:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/zekerflex?schema=public
REDIS_URL=redis://redis:6379

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel →
# "Install and run a connector" → Docker → copy the token after `--token`).
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN

# ---- SELF-HOSTED AI (in-compose) ---------------------------------------

LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_FAST_MODEL=llama3.2:1b
LLM_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_MS=180000
LLM_KEEP_ALIVE=30m

# AI budget governor (local inference is free; these are runaway guards).
AI_MAX_CONCURRENCY=3
AI_REQUESTS_PER_MIN=60
AI_DAILY_TOKEN_BUDGET=8000000
AI_MAX_WAIT_MS=120000
AI_ALLOW_REMOTE=false

# ---- WEB PUSH (self-hosted VAPID) -------------------------------------
# Generate a keypair: `npm run vapid:keys` (or `npm run gen:secrets`).
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_CONTACT=mailto:info@zekerflex.com

# ---- OUTBOUND E-MAIL --------------------------------------------------
# Every message is always captured in /admin/mail. Set SMTP_HOST to also
# deliver for real.
#   Real delivery: run `--profile mail` (bundled Postfix relay) and set
#     SMTP_HOST=postfix  SMTP_PORT=587  SMTP_SECURE=false
#   Dev catch-all:  run `--profile maildev` (Mailpit) and set
#     SMTP_HOST=mailpit  SMTP_PORT=1025
#   External relay: SMTP_HOST=smtp.postmarkapp.com (or Mailgun/SES) + SMTP_USER/PASS
SMTP_HOST=postfix
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_S=20
MAIL_FROM=noreply@zekerflex.com
MAIL_FROM_NAME=ZekerFlex
MAIL_ADMIN=info@zekerflex.com

# Postfix relay (only used by `--profile mail`). Leave RELAYHOST empty to
# deliver straight to recipients; set it to send via a smarthost instead.
MAIL_DOMAIN=zekerflex.com
MAIL_HOSTNAME=mail.zekerflex.com
RELAYHOST=
RELAYHOST_USERNAME=
RELAYHOST_PASSWORD=
DKIM_AUTOGENERATE=true

# ---- LOCAL SPEECH-TO-TEXT (optional) --------------------------------
# Run with `--profile voice`; the app then reaches it at http://whisper:8000/v1.
WHISPER_ENABLED=true
WHISPER_BASE_URL=http://whisper:8000/v1
WHISPER_MODEL=Systran/faster-whisper-base

# ---- LOCAL IMAGE GENERATION (optional, heavy) ----------------------
# Run with `--profile images`; reachable at http://sd:7860.
IMAGE_ENABLED=false
IMAGE_BACKEND=a1111
IMAGE_BASE_URL=http://sd:7860
IMAGE_MODEL=

# ---- DUTCH INTEGRATIONS --------------------------------------------
# Handelsregister + VAT validation. Keep the live key OUT of git.
KVKBASE_API_URL=https://api.kvkbase.nl
KVKBASE_API_KEY=

# Identity verification (KYC). Optional — the self-serve AI ID check works
# without it; Didit adds document + liveness verification.
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_CALLBACK_URL=https://app.jouwdomein.com/kyc/callback

# ---- GOOGLE OAUTH (optional) -------------------------------------
# Add https://app.jouwdomein.com/api/auth/callback/google as an authorised
# redirect URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# ---- SEPA PAYOUTS (optional) ------------------------------------
# Without these, payouts are simulated. Provide a PSD2 / payment provider.
SEPA_API_BASE_URL=
SEPA_API_KEY=
SEPA_CREDITOR_IBAN=
SEPA_CREDITOR_NAME=ZekerFlex B.V.

# ---- TUNABLES (leave unless you know why) ---------------------
PLATFORM_FEE_RATE=0.08
VAT_RATE_STANDARD=0.21
MATCHING_MIN_SCORE=0.55
UPLOADS_DIR=./storage/uploads
UPLOAD_MAX_BYTES=25000000
RAG_ENABLED=true
VOICE_ENABLED=true
JARVIS_BOOT_BRIEFING=false
