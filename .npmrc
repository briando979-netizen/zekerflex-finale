# onnxruntime-node (gezichtscontrole, lib/kyc/gezicht) haalt bij het installeren op Linux standaard ook het
# GPU-pakket op (honderden MB; een installatie met weinig geheugen werd daarop afgebroken). Wij rekenen op
# de processor, dus overslaan. De Dockerfile zet hetzelfde als omgevingsvariabele (die kopieert dit bestand niet).
onnxruntime-node-install=skip
