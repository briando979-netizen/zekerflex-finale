# ---------------------------------------------------------------------------
# ZekerFlex environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Auth - generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (optional). Authorized redirect URI:
#   {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal cron (matching follow-up worker). Required in production.
INTERNAL_CRON_TOKEN=change-me-min-16-chars

# Database (PostgreSQL + Prisma)
DATABASE_URL=postgresql://zekerflex:zekerflex@localhost:5432/zekerflex?schema=public

# Redis (job feed, geofencing locks, travel-time cache)
REDIS_URL=redis://localhost:6379

# Matching engine defaults (branch config can override)
MATCHING_MIN_SCORE=0.55
MATCHING_MAX_TRAVEL_MINUTES=75
MATCHING_WEIGHT_RELIABILITY=0.4
MATCHING_WEIGHT_TRAVEL=0.35
MATCHING_WEIGHT_SKILL=0.25

# Google Maps Platform (Distance Matrix / Routes API)
GOOGLE_MAPS_API_KEY=
# OpenOV / public-transport fallback endpoint
OPENOV_BASE_URL=https://api.openov.nl

# Web Push (self-hosted, primary push channel). Generate with: npm run vapid:keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_CONTACT=mailto:bounced@zekerflex.com

# Firebase Cloud Messaging (OPTIONAL secondary provider for native apps)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Self-hosted LLM - any OpenAI-compatible endpoint (Ollama / vLLM / llama.cpp)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_FAST_MODEL=llama3.2:1b
LLM_API_KEY=
# Local embedding model for RAG (e.g. `ollama pull nomic-embed-text`)
LLM_EMBED_MODEL=
LLM_TIMEOUT_MS=30000
# Fail-safe auto-retry: a brief Ollama hiccup never surfaces as "not reachable"
LLM_RETRY_MAX=6
LLM_RETRY_BASE_MS=600
LLM_RETRY_MAX_WAIT_MS=120000
LLM_KEEP_ALIVE=30m

# Voice / TTS - 100% local. Browser speech synthesis always works; Piper adds a
# natural server-side voice (https://github.com/rhasspy/piper).
VOICE_ENABLED=true
PIPER_BIN=
PIPER_MODEL=

# Local RAG / total memory (Float[] embeddings + JS cosine; no pgvector needed)
RAG_ENABLED=true
RAG_EMBED_DIM=768
RAG_MAX_CHUNKS=8000

# AI budget governor - local throttling + daily token circuit breaker
AI_MAX_CONCURRENCY=2
AI_REQUESTS_PER_MIN=30
AI_MIN_INTERVAL_MS=0
AI_DAILY_TOKEN_BUDGET=3000000
AI_MAX_WAIT_MS=45000
AI_BUDGET_HARD=true
AI_ALLOW_REMOTE=false

# Local upload storage (on the box's own disk)
UPLOADS_DIR=./storage/uploads
UPLOAD_MAX_BYTES=25000000

# Speak a status briefing on server boot
JARVIS_BOOT_BRIEFING=false

# Instant SEPA payment provider (bank / Stripe / Mollie)
SEPA_API_BASE_URL=
SEPA_API_KEY=
SEPA_CREDITOR_IBAN=
SEPA_CREDITOR_NAME=ZekerFlex B.V.

# KVKBase - Dutch Handelsregister company data & VAT validation
KVKBASE_API_URL=https://api.kvkbase.nl
KVKBASE_API_KEY=

# Didit - KYC / identity verification (business.didit.me)
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_CALLBACK_URL=http://localhost:3000/kyc/callback


# Compliance (Wet DBA) thresholds - rolling 12 month window
DBA_MAX_HOURS_PER_CLIENT=1200
DBA_WARN_HOURS_PER_CLIENT=900
DBA_MAX_CONSECUTIVE_WEEKS=26
DBA_MAX_CLIENT_REVENUE_SHARE=0.7

# Platform economics
PLATFORM_FEE_RATE=0.08
VAT_RATE_STANDARD=0.21

# Self-hosted image generation (marketing Studio). Optional; needs a local
# Stable Diffusion server (AUTOMATIC1111 / Forge with --api, or an
# OpenAI-compatible image endpoint, or ComfyUI).
IMAGE_ENABLED=false
IMAGE_BACKEND=a1111
IMAGE_BASE_URL=http://localhost:7860
IMAGE_MODEL=
IMAGE_API_KEY=
IMAGE_TIMEOUT_MS=300000
IMAGE_STEPS=28
IMAGE_CFG=5.5
IMAGE_SAMPLER=DPM++ 2M Karras
IMAGE_COMFY_WORKFLOW=

# Outbound e-mail. Messages are always captured in storage/mail (/admin/mail).
# Set SMTP_HOST to also deliver (Mailpit/MailHog :1025, Postfix, or a relay).
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_S=20
MAIL_FROM=noreply@zekerflex.com
MAIL_FROM_NAME=ZekerFlex
MAIL_ADMIN=info@zekerflex.com
MAIL_REPLY_TO=info@zekerflex.com
MAIL_UITZEND_FROM=uitzendbureau@zekerflex.com
MAIL_NIEUWSBRIEF_FROM=nieuwsbrief@zekerflex.com

# Local speech-to-text for the Jarvis mic (optional; OpenAI-compatible).
WHISPER_ENABLED=false
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=Systran/faster-whisper-base
WHISPER_API_KEY=
