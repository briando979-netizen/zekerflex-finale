// ---------------------------------------------------------------------------
// ZekerFlex - Prisma schema
// PostgreSQL. All monetary values are stored as integer cents (Int) to avoid
// floating point drift. Coordinates are decimal degrees (Float).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection is fine for the app at runtime, but `prisma
  // migrate deploy` needs a direct connection for its advisory lock / DDL.
  // Falls back to DATABASE_URL when unset (e.g. local dev, non-Neon hosts).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ===========================================================================
// Enterprise hierarchy & identity
// ===========================================================================

enum TenantType {
  PLATFORM
  ENTERPRISE_HQ
  FRANCHISE
}

enum UserRole {
  FREELANCER
  LOCAL_MANAGER // approves timesheets for one or more locations (branches)
  HQ_ADMIN // manages an organization (tenant): SSO, billing, all locations
  DISPUTE_MANAGER
  SALES // field sales rep: logs company visits, sends account invites
  PLATFORM_ADMIN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// Freelancer trust/quality tier. Drives a small matching bonus and unlocks
// higher-value shifts / instant payout limits.
enum BadgeLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  type      TenantType
  country   String     @default("NL") // ISO 3166-1 alpha-2
  kvkNumber String?    @unique
  vatNumber String?    @unique

  parentId String?
  parent   Tenant?  @relation("TenantHierarchy", fields: [parentId], references: [id])
  children Tenant[] @relation("TenantHierarchy")

  ssoEnabled   Boolean @default(false)
  ssoIssuerUrl String?

  // Validated Handelsregister data (KVKBase) captured at registration.
  companyRegistrationId String?              @unique
  companyRegistration   CompanyRegistration? @relation(fields: [companyRegistrationId], references: [id])

  // Stripe Customer for recurring billing (API subscriptions) — separate from the
  // one-off Checkout sessions on Invoice, which don't need a persistent customer.
  stripeCustomerId String? @unique

  branches             Branch[]
  memberships          Membership[]
  invoicesFrom         Invoice[]             @relation("InvoiceIssuerTenant")
  invoicesTo           Invoice[]             @relation("InvoiceRecipientTenant")
  modelAgreements      ModelAgreement[]
  apiKeys              ApiKey[]
  apiSubscription      ApiSubscription?
  webhookSubscriptions WebhookSubscription[]
  favoritePools        FavoritePool[]
  credits              TenantCredit[]
  managedWebsite       ManagedWebsite?
  rijschool            Rijschool?
  horecaZaak           HorecaZaak?
  shopProducts         ShopProduct[]         @relation("ShopSeller")
  employees            Employee[]            @relation("Employees")

  // Marketplace
  appsDeveloped        MarketplaceApp[]      @relation("AppDeveloper")
  appInstallations     MarketplaceAppInstallation[] @relation("AppInstallations")
  appReviews           AppReview[]           @relation("AppReviews")
  developer            Developer?
  partner              Partner?
  reseller             Reseller?

  // Accounting
  invoicesIssued       Invoice[]             @relation("InvoiceIssuer")
  invoicesReceived     Invoice[]             @relation("InvoiceRecipient")
  expenses             Expense[]
  journalEntries       JournalEntry[]
  taxPayments          TaxPayment[]

  // Email Marketing
  emailTemplates       EmailTemplate[]
  emailCampaigns       EmailCampaign[]
  emailLists           EmailList[]
  emailSubscribers     EmailSubscriber[]
  emailAutomations     EmailAutomation[]
  agency               Agency?
  extensionsDeveloped  Extension[]           @relation("ExtensionDeveloper")
  templateCreated      Template[]            @relation("TemplateCreator")
  addOns               TenantAddOn[]
  dataExchangesProvided DataExchange[]       @relation("DataExchangeProvider")
  dataExchangesConsumed DataExchange[]       @relation("DataExchangeConsumer")
  gallery              Gallery?

  // Surveys & Feedback
  surveys              Survey[]
  feedback             Feedback[]
  npsTracking          NpsTracking[]
  feedbackWidget       FeedbackWidget?

  // Digital Asset Management (DAM)
  damAssets            DamAsset[]            @relation("DamAssets")
  damFolders           DamFolder[]           @relation("DamFolders")
  damCollections       DamCollection[]       @relation("DamCollections")

  // Custom Fields & Forms
  customFields         CustomField[]
  forms                Form[]
  formResponses        FormResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  fullName        String
  phone           String?
  // bcrypt hash; null for SSO-only accounts.
  passwordHash    String?
  kycStatus       KycStatus @default(NOT_STARTED)
  disabledAt      DateTime?
  lastLoginAt     DateTime?
  // Null until the e-mail address is confirmed via the verification link.
  emailVerifiedAt DateTime?

  memberships          Membership[]
  freelancerProfile    FreelancerProfile?
  deviceFingerprints   DeviceFingerprint[]
  identityChecks       IdentityVerification[]
  approvedTimesheets   Timesheet[]            @relation("TimesheetApprover")
  raisedDisputes       Dispute[]              @relation("DisputeRaisedBy")
  resolvedDisputes     Dispute[]              @relation("DisputeResolvedBy")
  apiKeysCreated       ApiKey[]               @relation("ApiKeyCreatedBy")
  webPushSubscriptions WebPushSubscription[]
  shiftsCreated        Shift[]

  // Real-time features
  presence             UserPresence?
  sentMessages         ChatMessage[]
  reactions            MessageReaction[]

  // Affiliate & Referral
  affiliate            Affiliate?  @relation("AffiliateUser")
  referrals            Referral[]  @relation("ReferralUser")

  // Calendar & Scheduling
  calendars            Calendar[]
  calendarShares       CalendarShare[] @relation("CalendarShares")
  availability         UserAvailability?
  availabilityBlocks   AvailabilityBlock[]
  calendarIntegrations CalendarIntegration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// External API access — lets a third-party system (an integration partner, a
// connected employer's own tooling) call the public ZekerFlex API on behalf
// of one organization. Keys are shown once at creation; only a SHA-256 hash
// is stored, so a leaked database never reveals a usable key.
// ===========================================================================
model ApiKey {
  id        String @id @default(cuid())
  name      String // human label, e.g. "Boekhoudkoppeling Acme BV"
  prefix    String @unique // shown in lists, e.g. "zf_live_ab12cd34"
  hashedKey String // sha256 hex of the full secret

  // scopes this key may use, e.g. ["shifts:read", "invoices:read"]
  scopes String[]

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ===========================================================================
// A tenant's paid tier for the public API (lib/api-plans/catalog.ts holds the
// actual plan definitions — rate limits, monthly caps, allowed scopes — as
// code constants, not DB rows, mirroring how PLATFORM_FEE_PER_HOUR_CENTS is a
// plain env-configurable constant rather than a database-driven price table).
// No row at all (or status != "active") means the tenant is effectively on
// the free plan: lib/api-keys/gateway.ts treats "no subscription" as free,
// not as "blocked".
// ===========================================================================
model ApiSubscription {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planKey String @default("free") // see lib/api-plans/catalog.ts PLAN_KEYS
  status  String @default("active") // "active" | "past_due" | "canceled"

  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model WebhookSubscription {
  id               String   @id @default(cuid())
  tenantId         String
  url              String
  eventTypes       String[]
  secretCiphertext String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, active])
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  subscriptionId String
  eventType      String
  payload        Json
  statusCode     Int?
  attempts       Int       @default(0)
  deliveredAt    DateTime?
  nextAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([nextAttemptAt])
}

// A user's role within a specific tenant (RBAC + multi-tenant).
model Membership {
  id       String   @id @default(cuid())
  userId   String
  tenantId String
  role     UserRole

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Location scoping for LOCAL_MANAGER: empty => all locations of the org.
  scopedBranches BranchManager[]

  createdAt DateTime @default(now())

  @@unique([userId, tenantId, role])
  @@index([tenantId])
}

model BranchManager {
  id           String     @id @default(cuid())
  membershipId String
  branchId     String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
}

// ===========================================================================
// Branches (vestigingen) & auto-acceptance config
// ===========================================================================

enum BranchKind {
  PERMANENT // self-service-managed vestiging, shown on /werkgever/locaties
  AD_HOC // one-off address entered directly on a shift (e.g. an offsite demo) — hidden from the locations list
}

model Branch {
  id       String     @id @default(cuid())
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind     BranchKind @default(PERMANENT)

  name       String
  costCenter String? // for aggregated invoicing per kostenplaats

  addressLine String
  postalCode  String
  city        String
  latitude    Float
  longitude   Float

  // Geofence radius used for check-in validation (meters).
  geofenceRadiusMeters Int @default(150)

  // Auto-acceptance / matching configuration (see types/matching.ts).
  matchingConfig Json @default("{}")

  managers        BranchManager[]
  shifts          Shift[]
  timesheets      Timesheet[]
  dbaRecords      DbaComplianceRecord[]
  modelAgreements ModelAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ===========================================================================
// Freelancer profile, skills, fraud & identity enforcement
// ===========================================================================

model FreelancerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kvkNumber     String    @unique
  vatNumber     String?   @unique
  vatValid      Boolean   @default(false) // VIES check result
  kvkValid      Boolean   @default(false) // KVKBase check result: active registration
  kvkVerifiedAt DateTime?
  country       String    @default("NL") // ISO 3166-1 alpha-2

  // Validated Handelsregister data (KVKBase) captured at registration.
  companyRegistrationId String?              @unique
  companyRegistration   CompanyRegistration? @relation(fields: [companyRegistrationId], references: [id])

  // Destination for instant SEPA payouts. Legacy/manual path — superseded by
  // Stripe Connect below when the freelancer has completed that onboarding.
  payoutIban                    String?
  // True from the moment payoutIban is CHANGED on an already-verified profile
  // until a fresh bank document (ComplianceDocument kind=BANK) is uploaded for
  // it — see lib/compliance/documents.ts. Payouts are held while this is true
  // (lib/timesheets/approve.ts) so a hijacked account can't silently redirect
  // future payouts to a new account. Never retroactively set for existing
  // IBANs that were never changed — this only gates new changes.
  payoutIbanPendingVerification Boolean @default(false)

  // Stripe Connect Express — the freelancer's own onboarding to receive
  // Transfers from the platform's Stripe balance, paid out to their bank by
  // Stripe. stripePayoutsEnabled mirrors Stripe's account.payouts_enabled.
  stripeConnectedAccountId String? @unique
  stripePayoutsEnabled     Boolean @default(false)

  // Home base for travel-time estimation.
  homeLatitude   Float
  homeLongitude  Float
  homePostalCode String

  // Behavioural notification timing. When both quiet-hour bounds are set the
  // dispatcher suppresses push pings during that local window (the in-app offer
  // still lands). Hours are 0-23 in `timezone`; the window wraps midnight when
  // start > end (e.g. 22 -> 7).
  timezone        String @default("Europe/Amsterdam")
  quietHoursStart Int?
  quietHoursEnd   Int?

  // Behavioural Timing Notifier v2: hours (0-23, local) learned from actual
  // engagement events. When non-empty the dispatcher prefers these over the
  // manual quiet-hours window. Recomputed by /api/internal/active-hours/recompute.
  learnedActiveHours    Int[]     @default([])
  activeHoursComputedAt DateTime?

  // Rolling behavioural scores in [0,1].
  // Starts at 100% (benefit of the doubt for a worker with no history yet —
  // matches attendancePct()'s null-for-no-history handling in
  // lib/profile/card.ts) — no-shows, cancellations, punctuality.
  // NOTE: nothing currently adjusts this after account creation; it's a
  // static starting value, not yet a real, continuously-computed score.
  reliabilityScore Float @default(1.0)
  acceptanceScore  Float @default(0.5) // historical offer acceptance rate

  badgeLevel      BadgeLevel @default(BRONZE)
  shiftsCompleted Int        @default(0)

  // Enforcement flags.
  isBlacklisted        Boolean   @default(false)
  blacklistReason      String?
  matchingBlockedUntil DateTime? // set by DBA compliance throttle/block

  // Last ABU-fase (A/B/C) seen for this uitzendkracht by the phase-transition
  // sweep (lib/payroll/abu-phase-sweep.ts) — getUitzendStatus() recomputes the
  // phase fresh from timesheets every time, so this is the only persisted
  // value a transition can be diffed against.
  lastAbuPhase   String?
  lastAbuPhaseAt DateTime?

  skills               FreelancerSkill[]
  assignments          ShiftAssignment[]
  matches              ShiftMatch[]
  timesheets           Timesheet[]
  dbaRecords           DbaComplianceRecord[]
  webPushSubscriptions WebPushSubscription[]
  engagementEvents     EngagementEvent[]
  modelAgreements      ModelAgreement[]
  replacementsGiven    ReplacementRequest[]  @relation("ReplacementOriginal")
  replacementsTaken    ReplacementRequest[]  @relation("ReplacementSubstitute")
  // Cancellation-penalty invoices where this freelancer is the debtor (employer_owed direction).
  penaltyInvoicesOwed  Invoice[]             @relation("InvoiceRecipientFreelancer")
  // Favorited shifts (bookmarks)
  shiftFavorites      ShiftFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id          String            @id @default(cuid())
  name        String            @unique
  category    String
  freelancers FreelancerSkill[]
  shifts      Shift[]
}

model FreelancerSkill {
  id           String @id @default(cuid())
  freelancerId String
  skillId      String
  // Verified rating in [0,5] from client reviews.
  rating       Float  @default(0)
  shiftsWorked Int    @default(0)

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill      Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, skillId])
}

model DeviceFingerprint {
  id                String   @id @default(cuid())
  userId            String
  hardwareHash      String // SHA-256 of stable hardware attributes
  platform          String
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  trusted           Boolean  @default(false)
  // Populated when the same hardware hash is seen for a different user account.
  sharedWithUserIds String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hardwareHash])
  @@index([hardwareHash])
}

model IdentityVerification {
  id       String @id @default(cuid())
  userId   String
  provider String @default("DIDIT") // "DIDIT" | "VERIFF" | "READID"

  // Didit hosted-verification session.
  sessionId      String?   @unique // Didit session_id
  sessionUrl     String? // hosted verification URL to redirect the user to
  workflowId     String?
  vendorData     String? // our correlation id sent to Didit
  decisionStatus String? // raw Didit status: "Approved" | "Declined" | "In Review" | ...
  lastWebhookAt  DateTime?

  // Populated once the verification completes.
  documentType       String? // "PASSPORT" | "ID_CARD" | "RESIDENCE_PERMIT"
  documentNumberHash String?
  nfcChipVerified    Boolean @default(false)
  livenessScore      Float? // biometric liveness vector confidence [0,1]
  faceMatchScore     Float?

  status     KycStatus @default(PENDING)
  verifiedAt DateTime?
  expiresAt  DateTime?
  rawPayload Json      @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([documentNumberHash])
}

// Append-only audit + idempotency log for inbound Didit webhooks.
model DiditWebhookEvent {
  id              String   @id @default(cuid())
  sessionId       String
  status          String
  webhookType     String?
  signatureValid  Boolean
  signatureMethod String? // "simple" | "v2" | "original"
  rawPayload      Json
  receivedAt      DateTime @default(now())

  @@index([sessionId])
  @@index([receivedAt])
}

// ===========================================================================
// Company registration (KVKBase / Dutch Handelsregister)
// ===========================================================================

enum CompanyStatus {
  ACTIVE
  DISSOLVED
  UNKNOWN
}

model CompanyRegistration {
  id        String @id @default(cuid())
  kvkNumber String @unique
  source    String @default("KVKBASE")

  legalName           String
  tradeName           String?
  legalForm           String? // e.g. "Eenmanszaak", "Besloten Vennootschap"
  status              CompanyStatus @default(UNKNOWN)
  isActive            Boolean       @default(false)
  insolvent           Boolean       @default(false)
  establishmentNumber String? // vestigingsnummer of the main branch (enrichment)

  street      String?
  houseNumber String?
  postalCode  String?
  city        String?
  country     String  @default("NL")

  // SBI activity codes + the raw activity objects [{ sbiCode, description, isMain }].
  sbiCodes   String[] @default([])
  activities Json     @default("[]")

  registrationDate DateTime? // KVK inschrijfdatum
  employeeCount    Int?

  // VAT (from KVKBase enriched lookup / VIES).
  vatNumber      String?
  vatValid       Boolean?
  vatStatus      String? // "validated" | "stale" | "malformed" | "unvalidated"
  vatValidatedAt DateTime?

  rawProfile Json
  fetchedAt  DateTime @default(now())

  freelancerProfile FreelancerProfile?
  tenant            Tenant?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// W3C Web Push subscription (RFC 8291 aes128gcm). Primary, self-hosted push
// channel - the platform holds the VAPID keypair and encrypts payloads itself;
// no Firebase / Google service account involved.
model WebPushSubscription {
  id           String    @id @default(cuid())
  // Any account (calls, chat). freelancerId is also set for freelancers so the
  // shift-offer fan-out, which targets a profile, keeps working.
  userId       String?
  freelancerId String?
  endpoint     String    @unique // push service URL (opaque, vendor-specific)
  p256dh       String // base64url client public key (ECDH P-256)
  authKey      String // base64url 16-byte client auth secret
  userAgent    String?
  lastSeenAt   DateTime  @default(now())
  disabledAt   DateTime? // set when the push service reports 404/410 Gone

  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile? @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([freelancerId])
}

// ===========================================================================
// Shifts, matching & assignments
// ===========================================================================

enum ShiftStatus {
  DRAFT
  OPEN
  MATCHING
  PARTIALLY_FILLED
  FILLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShiftVisibility {
  PUBLIC // on the open marketplace, matched/notified to the full eligible pool
  POOL_ONLY // only invited FavoritePool member(s) can see/match/apply until published
}

enum MatchStatus {
  SCORED
  NOTIFIED
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  AUTO_ASSIGNED
}

enum TravelMode {
  DRIVING
  TRANSIT
  BICYCLING
  WALKING
}

model Shift {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Wie deze klus aanmaakte — voor factuurrouting naar de verantwoordelijke, niet naar admins
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  title            String
  description      String?
  // Shown to a freelancer as a distinct "kledingvoorschriften" item, separate
  // from the general description — the reageer flow asks them to explicitly
  // accept it, so it needs its own field rather than being buried in prose.
  dresscode        String?
  // Practical notes for the worker ("Extra informatie": where to report, parking,
  // who receives you, what to bring), shown on the klus card and detail page.
  extraInfo        String?
  // Restricts this shift to uitzendkrachten (payroll-track workers, see
  // FiscalProfile.workerKind) — a zzp'er/flexwerker can see it in the
  // marketplace but can't react to it. Set by the employer at creation time.
  viaUitzendbureau Boolean @default(false)
  requiredSkillId  String?
  requiredSkill    Skill?  @relation(fields: [requiredSkillId], references: [id])
  minSkillRating   Float   @default(0)

  startsAt        DateTime
  endsAt          DateTime
  breakMinutes    Int      @default(0)
  hourlyRateCents Int
  positions       Int      @default(1)

  status ShiftStatus @default(DRAFT)

  // Set at creation when the employer invites a favorite pool instead of
  // going straight to the open marketplace (see lib/shifts/create.ts). Stays
  // POOL_ONLY until the employer explicitly publishes it (publishShiftAction)
  // or forever if they never do — there is no automatic expiry/timeout.
  visibility  ShiftVisibility   @default(PUBLIC)
  poolInvites ShiftPoolInvite[]

  matches         ShiftMatch[]
  assignments     ShiftAssignment[]
  modelAgreements ModelAgreement[]
  favorites       ShiftFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([startsAt])
  @@index([createdByUserId])
}

// ===========================================================================
// Favorite pools — an employer groups favorited freelancers into named pools
// so a new shift can be privately invited to one pool before it ever reaches
// the open marketplace (lib/pools/store.ts, lib/shifts/create.ts). Separate
// from EmployerRelations.favorites (lib/employer/relations.ts, a flat KV
// list) because resolving "is freelancer X invited to shift Y" needs a real
// join against the matching-engine/marketplace queries, not a JSON blob scan.
// ===========================================================================
model FavoritePool {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String

  members FavoritePoolMember[]
  invites ShiftPoolInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model FavoritePoolMember {
  id               String       @id @default(cuid())
  poolId           String
  pool             FavoritePool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  freelancerUserId String

  addedAt DateTime @default(now())

  @@unique([poolId, freelancerUserId])
  @@index([freelancerUserId])
}

model ShiftPoolInvite {
  id      String       @id @default(cuid())
  shiftId String
  shift   Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  poolId  String
  pool    FavoritePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([shiftId, poolId])
  @@index([shiftId])
  @@index([poolId])
}

model ShiftMatch {
  id           String @id @default(cuid())
  shiftId      String
  freelancerId String

  score          Float // final weighted score [0,1]
  scoreBreakdown Json // { reliability, travel, skill, ... } - see types/matching.ts
  travelMode     TravelMode
  travelMinutes  Int
  distanceMeters Int
  withinGeofence Boolean

  status      MatchStatus @default(SCORED)
  notifiedAt  DateTime?
  respondedAt DateTime?
  expiresAt   DateTime?

  shift      Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([shiftId, freelancerId])
  @@index([shiftId, status])
  @@index([freelancerId, status])
}

model ShiftAssignment {
  id           String @id @default(cuid())
  shiftId      String
  freelancerId String

  acceptedAt   DateTime    @default(now())
  source       MatchStatus // ACCEPTED or AUTO_ASSIGNED
  cancelledAt  DateTime?
  cancelReason String?

  // Reminder tracking
  reminderSent1h Boolean @default(false)

  shift      Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  timesheet          Timesheet?
  replacementRequest ReplacementRequest?
  modelAgreement     ModelAgreement?

  @@unique([shiftId, freelancerId])
  @@index([freelancerId])
}

// ===========================================================================
// Wet DBA model agreements (modelovereenkomsten)
//
// The moment a freelancer engages with a client (accepts / is auto-assigned to
// a shift) the platform provisions a model-agreement instance for that
// freelancer <-> client relationship, based on a Belastingdienst-registered
// template. Work may start before it is signed; signatures are collected async.
// ===========================================================================

enum ModelAgreementType {
  VRIJE_VERVANGING // free substitution (ZekerFlex default - 1-click replacement)
  GEEN_WERKGEVERSGEZAG // no employer authority
  TUSSENKOMST // intermediary
  BRANCHE // sector-specific
}

enum ModelAgreementStatus {
  DRAFT
  PENDING_FREELANCER_SIGNATURE
  PENDING_CLIENT_SIGNATURE
  ACTIVE // both parties signed
  DECLINED
  SUPERSEDED
  EXPIRED
}

model ModelAgreement {
  id        String @id @default(cuid())
  reference String @unique // ZF-MOD-2026-000123

  freelancerId String
  tenantId     String // opdrachtgever (organization)
  branchId     String?
  shiftId      String? // the engagement that first triggered generation
  assignmentId String? @unique

  type   ModelAgreementType   @default(VRIJE_VERVANGING)
  status ModelAgreementStatus @default(PENDING_FREELANCER_SIGNATURE)

  // Belastingdienst-registered template this instance is based on.
  templateKey       String
  templateVersion   String
  belastingdienstNr String? // official registration number, once filed

  // Party snapshot at generation time (immutable once created).
  freelancerLegalName String
  freelancerKvkNumber String
  clientLegalName     String
  clientKvkNumber     String?

  hourlyRateCents  Int?
  scopeDescription String?

  freelancerSignedAt DateTime?
  clientSignedAt     DateTime?
  documentUrl        String?

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?           @relation(fields: [branchId], references: [id])
  shift      Shift?            @relation(fields: [shiftId], references: [id])
  assignment ShiftAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerId, status])
  @@index([tenantId, status])
}

// Generic gap-free counter (model-agreement references, etc.).
model Counter {
  key   String @id
  value Int    @default(0)
}

// Wet DBA "vrije vervanging" - 1-click in-app replacement.
enum ReplacementStatus {
  REQUESTED
  ACCEPTED_BY_SUBSTITUTE
  CONFIRMED
  REJECTED
  CANCELLED
}

model ReplacementRequest {
  id           String            @id @default(cuid())
  assignmentId String            @unique
  originalId   String
  substituteId String?
  status       ReplacementStatus @default(REQUESTED)
  reason       String?
  confirmedAt  DateTime?

  assignment ShiftAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  original   FreelancerProfile  @relation("ReplacementOriginal", fields: [originalId], references: [id])
  substitute FreelancerProfile? @relation("ReplacementSubstitute", fields: [substituteId], references: [id])

  createdAt DateTime @default(now())
}

// ===========================================================================
// Timesheets, GPS check-ins & disputes
// ===========================================================================

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DISPUTED
  REJECTED
  PAID
}

enum GpsEventType {
  CHECK_IN
  HEARTBEAT
  CHECK_OUT
}

model Timesheet {
  id           String @id @default(cuid())
  assignmentId String @unique
  freelancerId String
  branchId     String

  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  breakMinutes   Int       @default(0)

  hourlyRateCents Int
  // Denormalised billable hours, computed on submit/approve.
  billableMinutes Int @default(0)

  status       TimesheetStatus @default(DRAFT)
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?

  // Extra kosten (materiaal, reiskosten e.d.) die de freelancer, na vooraf
  // overleg met de opdrachtgever, incl. btw wil meefactureren op de zzp-factuur.
  extraCostsCents Int?
  extraCostsNote  String?

  assignment ShiftAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id])
  branch     Branch            @relation(fields: [branchId], references: [id])
  approvedBy User?             @relation("TimesheetApprover", fields: [approvedById], references: [id])

  gpsEvents GpsEvent[]
  dispute   Dispute?
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([freelancerId, status])
}

model GpsEvent {
  id                     String       @id @default(cuid())
  timesheetId            String
  type                   GpsEventType
  latitude               Float
  longitude              Float
  accuracyMeters         Float
  recordedAt             DateTime
  // Distance from branch centroid at time of event, and whether inside geofence.
  distanceToBranchMeters Float
  withinGeofence         Boolean
  deviceHash             String
  mocked                 Boolean      @default(false) // OS reported mock-location provider

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId, type])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_APPROVED // manager sided with freelancer's submitted hours
  RESOLVED_OVERRULED // manager imposed corrected hours
  ESCALATED
}

enum DisputeOrigin {
  MANAGER_REVIEW // a person flagged the hours
  FREELANCER_SUBMISSION // freelancer contested a correction
  GEOFENCE_VIOLATION // auto-raised: a check-in/out landed outside the geofence
  MOCK_LOCATION // auto-raised: OS reported a mock-location provider
}

model Dispute {
  id          String        @id @default(cuid())
  timesheetId String        @unique
  raisedById  String? // null => system-raised
  origin      DisputeOrigin @default(MANAGER_REVIEW)
  status      DisputeStatus @default(OPEN)
  reason      String

  claimedMinutes  Int // hours submitted by freelancer
  proposedMinutes Int // hours the client believes are correct
  resolvedMinutes Int? // final decision

  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?

  timesheet  Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  raisedBy   User?     @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  resolvedBy User?     @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ===========================================================================
// Billing (reverse / self-billing) & instant SEPA payouts
// ===========================================================================

enum InvoiceType {
  SELF_BILL_FREELANCER // company <- freelancer services (created on freelancer's behalf)
  PLATFORM_FEE // company <- ZekerFlex platform fee
  CANCELLATION_PENALTY // late-cancel / no-show 50% claim, either direction — see lib/claims
  UITZEND_FEE // company <- ZekerFlex (uitzendbureau): gross wage + markup, payroll track only
  DOMEIN // company <- ZekerFlex: domeinnaam, eerste jaar of verlenging (lib/domeinen/factuur.ts)
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum VatTreatment {
  STANDARD_RATE
  REVERSE_CHARGE // intra-EU B2B
  OUT_OF_SCOPE
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  type        InvoiceType
  status      InvoiceStatus @default(DRAFT)
  // Null for CANCELLATION_PENALTY — those don't stem from a worked timesheet.
  timesheetId String?

  issuerTenantId        String? // for PLATFORM_FEE the issuer is the platform tenant
  // Null when the debtor is a freelancer instead of a tenant (recipientFreelancerId set instead) —
  // the employer_owed direction of a cancellation-penalty claim.
  recipientTenantId     String?
  // Set only for CANCELLATION_PENALTY invoices where a freelancer is the debtor (late-cancel /
  // no-show owed to the employer). See lib/claims/billing.ts.
  recipientFreelancerId String?

  issuerFreelancerId String? // for SELF_BILL_FREELANCER

  // Back-reference to the KV CancellationClaim that generated this invoice (lib/claims/store.ts).
  claimId String?
  // DOMEIN: de domeinnaam waar deze factuur bij hoort (eerste jaar of een verlenging).
  domeinBestellingId String?

  currency      String       @default("EUR")
  vatTreatment  VatTreatment
  vatRate       Float // e.g. 0.21 or 0
  subtotalCents Int
  vatCents      Int
  totalCents    Int

  pdfUrl String?

  // Online collection of the invoice via Stripe Checkout (employer-paid
  // invoices only; the freelancer payout side still runs through
  // Payment/SEPA above and never touches these fields). Not unique: one bulk
  // checkout pays several invoices with a single payment intent.
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  // Collections lifecycle (CANCELLATION_PENALTY only) — see lib/claims/collections-sweep.ts.
  dueAt              DateTime?
  reminderSentAt     DateTime? // free statutory 14-day notice (WIK) before incassokosten may apply
  overdueEscalatedAt DateTime? // moved into the internal incasso queue, lateFeeCents charged
  lateFeeCents       Int?

  issuedAt DateTime?
  paidAt   DateTime?
  lines    InvoiceLine[]
  payment  Payment?

  timesheet           Timesheet?         @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  issuerTenant        Tenant?            @relation("InvoiceIssuerTenant", fields: [issuerTenantId], references: [id])
  recipientTenant     Tenant?            @relation("InvoiceRecipientTenant", fields: [recipientTenantId], references: [id])
  recipientFreelancer FreelancerProfile? @relation("InvoiceRecipientFreelancer", fields: [recipientFreelancerId], references: [id])

  createdAt DateTime @default(now())

  @@index([timesheetId])
  @@index([type, status])
  @@index([claimId])
  @@index([stripePaymentIntentId])
  @@index([domeinBestellingId])
}

// Monotonic per-(type, year) invoice counter. Incremented inside the approval
// transaction with a row lock so numbers are gap-free and unique.
model InvoiceSequence {
  id        String      @id @default(cuid())
  type      InvoiceType
  year      Int
  lastValue Int         @default(0)

  @@unique([type, year])
}

model InvoiceLine {
  id             String @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Float // hours
  unitPriceCents Int
  amountCents    Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  SEPA_INSTANT
  SEPA_STANDARD
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  SETTLED
  FAILED
  RETURNED
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String        @unique
  method      PaymentMethod @default(SEPA_INSTANT)
  status      PaymentStatus @default(PENDING)
  amountCents Int
  currency    String        @default("EUR")

  debtorIban   String? // platform funding account; null until SEPA_CREDITOR_IBAN is configured
  creditorIban String
  endToEndId   String  @unique // SEPA E2E reference / idempotency key
  providerRef  String?
  failureCode  String?

  submittedAt DateTime?
  settledAt   DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([status])
}

// ===========================================================================
// Tenant credit ledger — there is no bank rail to pay a tenant/employer out
// directly (only freelancers have a Stripe Connect account), so an
// employer_owed cancellation-penalty claim that a freelancer pays is credited
// here instead and deducted from that tenant's next generated invoice (see
// lib/billing/self-billing.ts and lib/claims/billing.ts).
// ===========================================================================
model TenantCredit {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  amountCents        Int
  reason             String
  sourceClaimId      String // the CancellationClaim (KV, lib/claims/store.ts) this credit came from
  appliedAt          DateTime? // null = not yet deducted from an invoice
  appliedToInvoiceId String?

  createdAt DateTime @default(now())

  @@index([tenantId, appliedAt])
}

// ===========================================================================
// Wet DBA compliance monitor
// ===========================================================================

enum DbaRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DbaAction {
  NONE
  WARN
  THROTTLE // no new matches at this branch for a cool-down period
  BLOCK // no new matches at this branch until manual review
}

model DbaComplianceRecord {
  id           String @id @default(cuid())
  freelancerId String
  branchId     String

  windowStart DateTime
  windowEnd   DateTime

  totalMinutes        Int
  engagementCount     Int
  distinctWeeks       Int
  maxConsecutiveWeeks Int
  clientRevenueShare  Float // this client's share of freelancer's platform revenue

  riskLevel DbaRiskLevel
  action    DbaAction
  rationale String

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([freelancerId, branchId])
  @@index([riskLevel])
  @@index([createdAt])
}

// ===========================================================================
// Audit trail
//
// Append-only record of security- and money-sensitive actions. Written through
// lib/audit.ts#recordAudit, which never throws - a failed audit write is logged
// and swallowed so it cannot abort the operation it records. Read-only surface:
// GET /api/admin/audit (PLATFORM_ADMIN).
// ===========================================================================

enum AuditCategory {
  AUTH
  SECURITY
  TIMESHEET
  BILLING
  DISPUTE
  KYC
  COMPANY
  AGREEMENT
  MATCHING
  ADMIN
  SALES
  ORCHESTRATION
}

model AuditLog {
  id       String        @id @default(cuid())
  category AuditCategory
  action   String // dotted verb, e.g. "timesheet.approved", "auth.login.failed"
  severity String        @default("info") // "info" | "warning" | "critical"

  // Actor. actorUserId is null for system / integration events; actorLabel then
  // carries a human hint ("system", "integration:didit", ...).
  actorUserId String?
  actorLabel  String  @default("system")
  ipAddress   String?
  userAgent   String?

  // Subject of the action.
  targetType String?
  targetId   String?
  summary    String
  metadata   Json    @default("{}")

  // Tamper-evident chain. `seq` is a gap-tolerant monotonic counter
  // (`audit_log_seq`); `hash` covers the immutable identity fields + `prevHash`
  // (NOT summary/ipAddress/userAgent, so AVG anonymisation can scrub PII in
  // place without breaking the chain). Nullable only for rows written before
  // the chain migration; `scripts/backfill-audit-chain.mjs` seals those.
  seq      BigInt  @unique @default(autoincrement())
  hash     String?
  prevHash String?

  // Deliberately no relation to User: actorUserId is in the hash, and a foreign
  // key with ON DELETE SET NULL rewrote it whenever an account was deleted,
  // breaking the chain (migration 20261102230000). Look names up with auditActors().

  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([seq])
}

// ===========================================================================
// Behavioural Timing Notifier v2 - engagement events
//
// Every meaningful in-app action is timestamped. `learnedActiveHours` on the
// freelancer profile is derived from the last ~200 events and the dispatcher
// prefers it over the manually configured quiet-hours window.
// ===========================================================================

enum EngagementKind {
  APP_OPEN
  OFFER_VIEWED
  OFFER_RESPONDED
  CHECK_IN
  TIMESHEET_SUBMITTED
}

model EngagementEvent {
  id           String         @id @default(cuid())
  freelancerId String
  kind         EngagementKind
  occurredAt   DateTime       @default(now())

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId, occurredAt])
}

// ===========================================================================
// Sales-AI - lead pipeline + LLM-drafted outreach
//
// The "recruiter motor" (lib/sales/engine.ts) discovers companies (KVKBase /
// careers-page crawl / CSV), enriches + scores them, drafts a 3-step outreach
// sequence and — in AUTOPILOT mode, within hard caps — sends it. REVIEW mode
// (the default) leaves every mail as a DRAFT for a human to approve.
// ===========================================================================

enum SalesLeadStatus {
  NEW
  ENRICHED
  QUEUED
  DRAFTED
  APPROVED
  SENT
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  WON
  LOST
  DISQUALIFIED
}

enum SalesOutreachStatus {
  DRAFT
  SCHEDULED
  APPROVED
  SENT
  FAILED
  SUPPRESSED
  DISCARDED
}

enum SalesSendMode {
  REVIEW
  AUTOPILOT
}

enum SalesCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  DONE
}

enum SalesSourceKind {
  KVKBASE
  CAREERS_URL
  CSV
}

model SalesCampaign {
  id     String              @id @default(cuid())
  name   String
  status SalesCampaignStatus @default(DRAFT)
  mode   SalesSendMode       @default(REVIEW)

  // Hard limits, enforced by the engine.
  dailyCap       Int     @default(40)
  sendStartHour  Int     @default(8)
  sendEndHour    Int     @default(18)
  workdaysOnly   Boolean @default(true)
  minScore       Int     @default(55)
  stepDelaysDays Int[]   @default([0, 4, 10])

  // KVKBase discovery targeting.
  targetSectors String[] @default([])
  targetCities  String[] @default([])

  fromAddress String?

  // AUTOPILOT is a deliberate, audited opt-in.
  autopilotConfirmedAt   DateTime?
  autopilotConfirmedById String?

  createdById String?

  leads   SalesLead[]
  sources SalesDiscoverySource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model SalesDiscoverySource {
  id             String          @id @default(cuid())
  campaignId     String?
  kind           SalesSourceKind
  url            String?
  label          String?
  configJson     Json            @default("{}")
  enabled        Boolean         @default(true)
  lastRunAt      DateTime?
  lastResultJson Json?

  campaign SalesCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
}

model SalesSuppression {
  email       String   @id
  domain      String?
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([domain])
}

model SalesEngineRun {
  id         String    @id @default(cuid())
  campaignId String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  discovered Int       @default(0)
  enriched   Int       @default(0)
  scored     Int       @default(0)
  drafted    Int       @default(0)
  sent       Int       @default(0)
  skipped    Int       @default(0)
  errorsJson Json      @default("[]")
  summary    String?

  @@index([startedAt])
}

model SalesLead {
  id           String          @id @default(cuid())
  companyName  String
  kvkNumber    String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  city         String?
  sector       String?
  source       String          @default("manual") // "manual" | "kvkbase" | "careers" | "import" | "field-visit" | "demo-request"
  status       SalesLeadStatus @default(NEW)

  campaignId      String?
  sourceUrl       String?
  vacancySignal   String?
  discoveredEmail String?

  // account-uitnodiging verstuurd na een bedrijfsbezoek
  invitedAt       DateTime?
  invitedTenantId String?

  // 0-100 fit score + the model's reasoning (heuristic or LLM).
  score          Int?
  scoreRationale String?
  notes          String?

  // Outreach-sequence bookkeeping.
  sequenceStep     Int       @default(0)
  nextActionAt     DateTime?
  suppressed       Boolean   @default(false)
  suppressedReason String?
  repliedAt        DateTime?
  bouncedAt        DateTime?

  enrichmentJson  Json      @default("{}")
  createdById     String?
  lastContactedAt DateTime?

  outreach SalesOutreach[]
  campaign SalesCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([kvkNumber])
  @@index([campaignId, nextActionAt])
}

model SalesOutreach {
  id      String              @id @default(cuid())
  leadId  String
  channel String              @default("email")
  status  SalesOutreachStatus @default(DRAFT)

  stepIndex   Int       @default(0)
  scheduledAt DateTime?

  subject String
  body    String

  generatedByModel String?
  editedByHuman    Boolean   @default(false)
  approvedById     String?
  approvedAt       DateTime?
  sentById         String?
  sentAt           DateTime?
  sentVia          String? // "autopilot" | "manual"
  mailId           String?
  failReason       String?

  lead SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, status])
}

// ===========================================================================
// Autonomous Orchestration Core (the "Jarvis loop")
//
// A cycle observes the platform (audit log, health, queue depths), asks the
// self-hosted LLM to interpret it, and records findings. It NEVER applies code
// or runs an un-confirmed mutation: CODE_PATCH findings hold a proposed diff as
// text for a human; CONSOLE_MUTATION findings carry an admin-console confirm
// token; CONSOLE_QUERY findings may carry a read-only result.
// ===========================================================================

enum OrchestrationTrigger {
  CRON
  MANUAL
}

enum OrchestrationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingActionKind {
  NONE
  CONSOLE_QUERY
  CONSOLE_MUTATION
  CODE_PATCH
  MANUAL
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  ACTIONED
  DISMISSED
}

model OrchestrationRun {
  id         String                 @id @default(cuid())
  trigger    OrchestrationTrigger
  status     OrchestrationRunStatus @default(RUNNING)
  model      String
  startedAt  DateTime               @default(now())
  finishedAt DateTime?

  snapshotJson Json    @default("{}")
  summary      String?
  error        String?

  findings OrchestrationFinding[]

  @@index([status, startedAt])
}

model OrchestrationFinding {
  id    String @id @default(cuid())
  runId String

  severity   FindingSeverity
  category   String
  title      String
  detail     String
  actionKind FindingActionKind @default(NONE)
  status     FindingStatus     @default(OPEN)

  // CONSOLE_QUERY: the read-only result. CONSOLE_MUTATION: a confirm token +
  // impact. CODE_PATCH: a proposed unified diff + which files it touches.
  actionPayload Json @default("{}")

  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?

  run OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([status, severity])
}

// ===========================================================================
// Voice / TTS - spontaneous spoken status updates
//
// Events (build green, task done, orchestration finding, new sales lead) push a
// VoiceAnnouncement. A connected admin client streams unspoken announcements
// via GET /api/voice/stream and speaks them - server-side (Piper, if configured)
// or with the browser's local speech synthesis. 100% local, no cloud TTS.
// ===========================================================================

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
}

model VoiceAnnouncement {
  id       String               @id @default(cuid())
  text     String
  category String // "orchestration" | "sales" | "build" | "status" | "security"
  priority AnnouncementPriority @default(NORMAL)
  source   String               @default("system")
  spokenAt DateTime?

  createdAt DateTime @default(now())

  @@index([spokenAt, createdAt])
}

// ===========================================================================
// Local RAG - total memory (no pgvector: Float[] embeddings + JS cosine)
//
// Everything indexable is chunked, embedded via the self-hosted embedding model
// (LLM_EMBED_MODEL) and stored here. `lib/rag/query.ts` retrieves context for
// the AI's answers, orchestration analysis and semantic search - all local.
// ===========================================================================

enum RagSourceType {
  CODE
  AUDIT
  DATABASE
  LEGAL
  SALES
  INTERACTION
}

model RagChunk {
  id          String        @id @default(cuid())
  sourceType  RagSourceType
  sourceRef   String // "lib/foo.ts" | "auditLog:<id>" | "salesLead:<id>" | ...
  title       String
  chunkIndex  Int           @default(0)
  content     String
  contentHash String        @unique // sha256(sourceRef|chunkIndex|content)
  embedding   Float[]
  embedDim    Int
  tokens      Int           @default(0)
  indexedAt   DateTime      @default(now())

  @@index([sourceType])
  @@index([sourceRef])
}

// ===========================================================================
// AI budget governor - local throttling + token accounting
//
// Every call to the self-hosted model passes through lib/ai/governor.ts:
// concurrency cap, per-minute rate window (time-slot), a daily token budget as
// a runaway-loop circuit breaker, and a minimum spacing between requests. This
// row records what each call actually cost.
// ===========================================================================

model AiUsageLog {
  id               String   @id @default(cuid())
  purpose          String   @default("unknown") // "orchestration" | "rag" | "sales" | ...
  model            String
  endpointHost     String   @default("local")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  durationMs       Int      @default(0)
  throttledMs      Int      @default(0)
  ok               Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([purpose, createdAt])
}

// ===========================================================================
// Local uploads - files added via the chatbar "+" button
//
// Bytes are written to ./storage/uploads on the box's own disk (gitignored);
// this row is the metadata. No object storage, no cloud.
// ===========================================================================

/// Upload bytes kept in Postgres (STORAGE_BACKEND=db, or automatically on
/// Vercel where the disk is read-only). Keyed by Upload.storageKey ("db:…").
model UploadBlob {
  storageKey String   @id
  bytes      Bytes
  createdAt  DateTime @default(now())
}

model Upload {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String   @default("application/octet-stream")
  sizeBytes    Int
  sha256       String
  storageKey   String   @unique // relative path under the uploads root
  uploadedById String?
  jarvisTurnId String?
  createdAt    DateTime @default(now())

  jarvisTurn         JarvisTurn?         @relation(fields: [jarvisTurnId], references: [id], onDelete: SetNull)
  complianceDocument ComplianceDocument?
  certificate        Certificate?

  @@index([uploadedById])
  @@index([createdAt])
}

// ===========================================================================
// Storage that used to live on local disk (storage/auth/reset,
// storage/compliance, storage/certificates, storage/payroll,
// storage/payouts/advances) — unsafe on Vercel's serverless functions, whose
// filesystem is read-only outside /tmp and /tmp itself is not shared across
// invocations. File *bytes* still go through Upload (local disk or S3 per
// STORAGE_BACKEND); everything here is metadata that must survive between
// requests, so it belongs in Postgres instead.
// ===========================================================================

// Generic JSON key-value store for the many small, low-traffic subsystems
// that used to keep one JSON file per entity on local disk (chat threads,
// reviews, claims, offers, communities, newsletter, demo bookings, fiscal
// data, profile/messaging prefs, ...). Same root cause as the models above:
// Vercel's serverless functions can't write outside /tmp. A generic table
// here is a much faster, lower-risk migration than a bespoke relational
// table per subsystem — every one of these was already "one JSON blob per
// key", so the shape barely changes, only the storage backend does.
model KeyValueStore {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model PasswordResetToken {
  id        String   @id // the token itself (random, url-safe)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Confirms a self-service AVG art. 17 erasure request made without being
// logged in (the Play Store "account deletion" web resource) — proves email
// ownership the same way PasswordResetToken proves it for a password reset.
model AccountDeletionToken {
  id        String   @id // the token itself (random, url-safe)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ComplianceDocKind {
  ID
  BANK
  OTHER
}

enum ComplianceDocStatus {
  UPLOADED
  APPROVED
  REJECTED
}

model ComplianceDocument {
  id         String              @id @default(cuid())
  userId     String
  kind       ComplianceDocKind
  uploadId   String              @unique
  status     ComplianceDocStatus @default(UPLOADED)
  note       String?
  uploadedAt DateTime            @default(now())

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

enum CertificateStatus {
  PENDING
  VALID
  EXPIRED
  REJECTED
}

model Certificate {
  id          String            @id @default(cuid())
  userId      String
  type        String
  customLabel String?
  number      String?
  issuedOn    DateTime?
  expiresOn   DateTime?
  uploadId    String?           @unique
  fileName    String?
  status      CertificateStatus
  statusNote  String?
  addedAt     DateTime          @default(now())
  verifiedAt  DateTime?

  upload Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([userId, type])
}

model PayrollRunRecord {
  isoWeek   String   @id
  status    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayslipRecord {
  id        String   @id @default(cuid())
  userId    String
  isoWeek   String
  data      Json
  createdAt DateTime @default(now())

  @@unique([userId, isoWeek])
  @@index([userId])
}

model PayoutPreference {
  userId    String   @id
  speed     String
  updatedAt DateTime @updatedAt
}

// The SEPA Credit Transfer batch (pain.001.001.03) generated once a payroll
// run is finalised — the real bank-ready payment file finaliseRun() used to
// stop short of producing. Generated once, immutable (re-finalising an
// already-finalised week is a no-op, see lib/payroll/engine.ts), downloaded
// from the admin payroll board for a human to submit in their own banking
// environment. ZekerFlex never calls a bank API to move this money itself.
model PayrollSepaBatch {
  id          String   @id @default(cuid())
  isoWeek     String   @unique
  xml         String
  debtorIban  String
  lineCount   Int
  skippedJson Json
  totalCents  Int
  generatedAt DateTime @default(now())
  generatedBy String

  @@index([isoWeek])
}

model AdvanceRecord {
  id                 String    @id @default(cuid())
  userId             String
  amountCents        Int
  feeCents           Int
  netCents           Int
  status             String
  kind               String?
  isoWeek            String?
  timesheetId        String?
  expectedGrossCents Int?
  payoutStatus       String?
  providerRef        String?
  note               String?
  requestedAt        DateTime  @default(now())
  settledAt          DateTime?
  paidAt             DateTime?
  reconciledAt       DateTime?
  reconciledNetCents Int?

  @@index([userId, status])
  @@index([userId, kind, isoWeek])
}

// Public webshop catalog managed by PLATFORM_ADMIN.
model ShopProduct {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String
  category      String
  gender        String? // "heren" | "vrouwen" | "kinderen" | "unisex" — null = not gendered (e.g. PBM)
  collection    String? // e.g. "Winter 2026", "Zakelijk" — null for the existing Werk & PBM line
  isBundle      Boolean  @default(false)
  priceCents    Int
  costCents     Int? // inkoopprijs (COGS) — voor margeberekening in admin
  stock         Int      @default(0)
  imageUploadId String?
  modelUploadId String?
  imageUrl      String?
  modelPhotoUrl String?
  badge         String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  variants   ShopProductVariant[]
  bundleOf   ShopBundleItem[]     @relation("BundleProduct")
  includedIn ShopBundleItem[]     @relation("ItemProduct")

  // Verkoper op de marktplaats (null = ZekerFlex zelf, lib/shop/verkoper.ts). Een
  // verkopersproduct is pas zichtbaar (active) na goedkeuring door de beheerder.
  sellerTenantId String?
  seller         Tenant? @relation("ShopSeller", fields: [sellerTenantId], references: [id], onDelete: Cascade)
  sellerStatus   String? // "in_beoordeling" | "goedgekeurd" | "afgewezen" | "gepauzeerd"
  sellerNote     String? // reden bij afwijzen, voor de verkoper

  @@index([active, sortOrder])
  @@index([category, active])
  @@index([gender, collection])
  @@index([sellerTenantId, sellerStatus])
}

// One stock-tracked purchasable unit of a product (a specific size/color
// combination). Products without real variants still get exactly one row
// (see the seed/migration note) so the cart/checkout pipeline always keys
// on a variantId, never a bare productId.
model ShopProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String?
  color      String?
  priceCents Int? // null = inherit ShopProduct.priceCents
  stock      Int         @default(0)
  sku        String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
}

// A bundle ShopProduct (isBundle: true) lists the real products it contains,
// purely for display ("Deze bundel bevat:") — it's still sold and paid for
// as a single line at the bundle's own ShopProduct.priceCents.
model ShopBundleItem {
  id              String @id @default(cuid())
  bundleProductId String
  itemProductId   String
  qty             Int    @default(1)

  bundleProduct ShopProduct @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  itemProduct   ShopProduct @relation("ItemProduct", fields: [itemProductId], references: [id], onDelete: Cascade)

  @@unique([bundleProductId, itemProductId])
}

enum ShopOrderStatus {
  PENDING_PAYMENT // Stripe Checkout session created, awaiting payment confirmation
  RECEIVED // paid — ready for fulfillment
  CONFIRMED
  SHIPPED
  CANCELLED
  PAYMENT_FAILED
}

// Real order capture for the /shop checkout — the items are a priced snapshot
// at order time (name/price can change later on ShopProduct; this is what the
// customer actually agreed to pay).
model ShopOrder {
  id                    String          @id @default(cuid())
  status                ShopOrderStatus @default(PENDING_PAYMENT)
  firstName             String
  lastName              String
  email                 String
  address               String
  postalCode            String
  city                  String
  itemsJson             Json
  subtotalCents         Int
  shippingCents         Int
  totalCents            Int
  stripeSessionId       String?         @unique
  stripePaymentIntentId String?         @unique
  carrier               String? // e.g. "postnl" | "dhl" - free text, shown next to the tracking link
  trackingNumber        String?
  // zakelijk bestellen (5 nov 2026): op de bon, de pakbon en in de mails; alle drie optioneel
  companyName           String?
  vatNumber             String? // genormaliseerd, bijv. NL123456789B01
  reference             String? // eigen referentie of inkoopnummer van de klant
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ===========================================================================
// Managed Website — ZekerFlex beheert de website van een opdrachtgever. Zit
// achter een abonnement (Stripe): vergrendeld tot betaald, daarna vult de
// opdrachtgever zijn websitegegevens + SSH-toegang in (AES-256-GCM-verzegeld
// via lib/security/sealed-secret) zodat wij het onderhoud overnemen.
// ===========================================================================
enum ManagedWebsiteStatus {
  PENDING_PAYMENT // abonnement gestart, wacht op Stripe-betaling
  ONBOARDING // betaald, wacht op websitegegevens
  SUBMITTED // gegevens ingevuld, wij nemen het over
  ACTIVE // wij beheren de site
  PAUSED
  CANCELLED
}

model ManagedWebsite {
  id              String               @id @default(cuid())
  tenantId        String               @unique
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedById   String?
  status          ManagedWebsiteStatus @default(PENDING_PAYMENT)
  plan            String? // "basis" | "pro"
  domain          String?
  provider        String? // hostingpartij/platform (WordPress, Wix, eigen VPS, …)
  notes           String?
  // AES-256-GCM-verzegelde JSON met SSH-host/gebruiker/poort/privésleutel +
  // hosting-login. NOOIT plaintext in de DB. Zie lib/security/sealed-secret.ts.
  secretsSealed   String?
  secretsSetAt    DateTime?
  stripeSubId     String?
  stripeSessionId String?              @unique
  subscribedAt    DateTime?
  submittedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
}

// ===========================================================================
// Jarvis conversational turns + live progress events
//
// A "turn" is one user message routed through the Jarvis core (RAG, admin
// console, orchestration, briefing). Progress events stream to the chat UI as
// collapsible blocks; each event names the sub-agent that produced it.
// ===========================================================================

enum JarvisTurnStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum JarvisEventKind {
  THINKING
  TOOL_CALL
  TOOL_RESULT
  AGENT_DELEGATION
  MESSAGE
  ERROR
}

model JarvisTurn {
  id        String           @id @default(cuid())
  userId    String?
  prompt    String
  status    JarvisTurnStatus @default(RUNNING)
  answer    String?
  error     String?
  startedAt DateTime         @default(now())
  endedAt   DateTime?

  events  JarvisEvent[]
  uploads Upload[]

  @@index([userId, startedAt])
  @@index([status])
}

model JarvisEvent {
  id         String          @id @default(cuid())
  turnId     String
  seq        Int
  kind       JarvisEventKind
  agent      String          @default("jarvis") // "jarvis" | "developer:tom" | "sales" | "analyst"
  title      String
  detail     String?
  payload    Json            @default("{}")
  durationMs Int?
  createdAt  DateTime        @default(now())

  turn JarvisTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, seq])
  @@index([turnId])
}

// ===========================================================================
// Sovereign analytics - a local, cookie-free alternative to Google Analytics
//
// The client beacon (components/analytics/AnalyticsBeacon.tsx) posts events to
// /api/analytics/track. Everything is stored here on the box; no third-party
// script, no cross-site cookie. The session id is a per-tab random string in
// sessionStorage, and the user-agent is only ever stored as a short hash.
// ===========================================================================

enum AnalyticsEventType {
  PAGEVIEW
  CLICK
  INTERACTION
  CUSTOM
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  type         AnalyticsEventType
  path         String
  referrerHost String?
  sessionId    String // random per-tab id (sessionStorage, NOT a cookie)
  userId       String?
  label        String? // element label / custom event name
  meta         Json               @default("{}")
  uaHash       String? // sha256(user-agent).slice(0,16) - no raw UA stored
  createdAt    DateTime           @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([sessionId, createdAt])
}

// ===========================================================================
// ZekerFlex Bank — one account per freelancer (user), per organisation
// (tenant) and one for the platform. The ledger lives here; money in and out
// moves through Stripe (top-ups via Checkout, cards via Issuing, payouts via
// the SEPA batch). The funds themselves are held on the platform's Stripe
// balance. balanceCents only changes together with a BankEntry, in one
// transaction (lib/bank/ledger.ts).
// ===========================================================================

enum BankOwnerType {
  USER
  TENANT
  PLATFORM
}

model BankAccount {
  id           String        @id @default(cuid())
  ownerType    BankOwnerType
  userId       String?       @unique
  tenantId     String?       @unique
  /// human-readable account number shown in the app ("ZF 1234 5678 90")
  number       String        @unique
  holderName   String
  balanceCents Int           @default(0)
  currency     String        @default("EUR")
  /// own IBAN for withdrawals
  payoutIban   String?
  payoutName   String?
  frozenAt     DateTime?
  frozenReason String?
  /// next time the monthly account fee is due
  nextFeeAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  entries BankEntry[]
  cards   BankCard[]
  pots    BankPot[]

  // bestaat al sinds migratie 20261018120000_scale_indexes; hier opgenomen zodat Prisma hem niet weg wil halen
  @@index([nextFeeAt])
}

model BankEntry {
  id                String      @id @default(cuid())
  accountId         String
  account           BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// positive = money in, negative = money out
  amountCents       Int
  balanceAfterCents Int
  /// TOPUP | WITHDRAWAL | FEE_MONTHLY | FEE_CARD | CARD_SPEND | CARD_REFUND | INVOICE_PAYMENT | EARNING | TRANSFER | ADJUSTMENT
  kind              String
  description       String
  counterparty      String?
  /// Stripe id, invoice id, card authorization … whatever this booking came from
  reference         String?
  idempotencyKey    String      @unique
  createdAt         DateTime    @default(now())

  @@index([accountId, createdAt])
  // bestaat al sinds migratie 20261018120000_scale_indexes
  @@index([createdAt])
}

model BankCard {
  id                 String      @id @default(cuid())
  accountId          String
  account            BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stripeCardId       String      @unique
  stripeCardholderId String
  /// virtual | physical
  type               String
  brand              String
  last4              String
  expMonth           Int
  expYear            Int
  /// active | inactive | canceled (Stripe's card status)
  status             String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([accountId])
}

// A pot ("potje") or a fixed-term deposit inside a ZekerFlex Bank account.
// Money moved in leaves the main balance (POT_IN entry) and sits here; a
// FIXED pot can't be emptied before lockedUntil and earns interestBps.
model BankPot {
  id           String      @id @default(cuid())
  accountId    String
  account      BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  emoji        String      @default("🎯")
  kind         String      @default("POT") // POT | FIXED
  balanceCents Int         @default(0)
  targetCents  Int?
  termYears    Int?
  interestBps  Int         @default(0)
  lockedUntil  DateTime?
  closedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([accountId])
}

// ===========================================================================
// Rijschool-pakket. Een rijschool is een gewoon ZekerFlex-bedrijf (Tenant) met
// dit onderdeel aan, en houdt dus alles wat ZekerFlex al biedt (mail,
// telefonie, AI-beller, websitebouwer, facturen). Eigen website met
// leerlingportaal en instructeur-app op /rijschool/<slug>. Leerlingen en
// instructeurs hebben lichte eigen accounts (geen ZekerFlex-gebruikers); de
// eigenaar beheert alles vanuit /werkgever/rijschool. Zie lib/rijschool.
// ===========================================================================
enum RijschoolLeerlingStatus {
  AANMELDING // proefles of inschrijving via de website, nog niet gestart
  ACTIEF
  GESLAAGD
  GESTOPT
}

enum RijschoolLesSoort {
  LES
  PROEFLES
  TOETS // tussentijdse toets
  EXAMEN
}

enum RijschoolLesStatus {
  GEPLAND
  VOLTOOID
  GEANNULEERD
  NIET_VERSCHENEN
}

enum RijschoolBetalingStatus {
  OPEN
  BETAALD
  MISLUKT
  VERVALLEN
}

enum RijschoolBetaalMethode {
  IDEAL
  PIN
  CONTANT
  OVERBOEKING
}

model Rijschool {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug            String   @unique
  naam            String
  plaats          String   @default("")
  adres           String   @default("")
  telefoon        String   @default("")
  email           String   @default("")
  kvk             String   @default("")
  kleur           String   @default("#1D4E89")
  accent          String   @default("#F2B544")
  lesMinuten      Int      @default(60)
  annuleerUren    Int      @default(24) // kosteloos annuleren tot zoveel uur vooraf
  proeflesOnline  Boolean  @default(true) // bezoekers plannen zelf een proefles
  zelfPlannen     Boolean  @default(false) // leerlingen plannen zelf lessen in vrije tijden
  online          Boolean  @default(false) // website publiek; anders alleen zichtbaar voor de eigenaar
  // Teksten en keuzes van de website (lib/rijschool/website.ts): kop, intro,
  // werkgebied, slagingspercentage, sterke punten, veelgestelde vragen.
  website         Json     @default("{}")
  // Stripe Connect: lesgeld gaat rechtstreeks naar de rijschool, niet via ZekerFlex.
  stripeAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instructeurs RijschoolInstructeur[]
  voertuigen   RijschoolVoertuig[]
  producten    RijschoolProduct[]
  leerlingen   RijschoolLeerling[]
  lessen       RijschoolLes[]
  betalingen   RijschoolBetaling[]
  berichten    RijschoolBericht[]
  app          RijschoolApp?
}

model RijschoolInstructeur {
  id              String    @id @default(cuid())
  rijschoolId     String
  rijschool       Rijschool @relation(fields: [rijschoolId], references: [id], onDelete: Cascade)
  naam            String
  email           String
  telefoon        String    @default("")
  bio             String    @default("")
  categorieen     String[]  @default(["B"])
  // Vaste werktijden: [{ dag: 1..7 (ma..zo), van: "08:00", tot: "17:00" }]
  beschikbaarheid Json      @default("[]")
  kleur           String    @default("#1D4E89")
  actief          Boolean   @default(true)
  wachtwoordHash  String?
  uitnodigingHash String?   @unique // sha256 van de link waarmee je een wachtwoord kiest
  uitnodigingTot  DateTime?
  laatstIngelogd  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  leerlingen RijschoolLeerling[]
  lessen     RijschoolLes[]

  @@unique([rijschoolId, email])
}

model RijschoolVoertuig {
  id          String    @id @default(cuid())
  rijschoolId String
  rijschool   Rijschool @relation(fields: [rijschoolId], references: [id], onDelete: Cascade)
  naam        String // "Volkswagen Golf"
  kenteken    String    @default("")
  automaat    Boolean   @default(false)
  categorie   String    @default("B")
  actief      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  lessen RijschoolLes[]

  @@index([rijschoolId])
}

model RijschoolProduct {
  id           String    @id @default(cuid())
  rijschoolId  String
  rijschool    Rijschool @relation(fields: [rijschoolId], references: [id], onDelete: Cascade)
  naam         String
  omschrijving String    @default("")
  soort        String    @default("PAKKET") // LES | PAKKET | EXAMEN | PROEFLES | OVERIG
  prijsCent    Int
  lessen       Int       @default(0) // zoveel lessen tegoed na betaling
  lesMinuten   Int       @default(60)
  examen       Boolean   @default(false) // inclusief praktijkexamen
  zichtbaar    Boolean   @default(true) // te koop op de website en in de leerling-app
  populair     Boolean   @default(false)
  volgorde     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  betalingen RijschoolBetaling[]

  @@index([rijschoolId])
}

model RijschoolLeerling {
  id              String                  @id @default(cuid())
  rijschoolId     String
  rijschool       Rijschool               @relation(fields: [rijschoolId], references: [id], onDelete: Cascade)
  instructeurId   String?
  instructeur     RijschoolInstructeur?   @relation(fields: [instructeurId], references: [id], onDelete: SetNull)
  naam            String
  email           String
  telefoon        String                  @default("")
  adres           String                  @default("") // standaard ophaaladres
  geboortedatum   DateTime?
  automaat        Boolean                 @default(false)
  status          RijschoolLeerlingStatus @default(AANMELDING)
  theorieGehaald  Boolean                 @default(false)
  examenDatum     DateTime?
  notitie         String                  @default("") // alleen voor de rijschool
  // Theorie oefenen: per onderdeel de beste ronde { [onderdeel]: { goed, totaal, at } }
  theorie         Json                    @default("{}")
  wachtwoordHash  String?
  uitnodigingHash String?                 @unique
  uitnodigingTot  DateTime?
  laatstIngelogd  DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  lessen     RijschoolLes[]
  tegoed     RijschoolTegoed[]
  betalingen RijschoolBetaling[]
  berichten  RijschoolBericht[]

  @@unique([rijschoolId, email])
  @@index([rijschoolId, status])
}

// Berichten tussen een leerling en de rijschool (lib/rijschool/berichten.ts): één
// gesprek per leerling. Namens de school schrijft het beheer of een instructeur.
model RijschoolBericht {
  id          String            @id @default(cuid())
  rijschoolId String
  rijschool   Rijschool         @relation(fields: [rijschoolId], references: [id], onDelete: Cascade)
  leerlingId  String
  leerling    RijschoolLeerling @relation(fields: [leerlingId], references: [id], onDelete: Cascade)
  vanLeerling Boolean
  afzender    String            @default("") // naam van wie namens de school schreef
  tekst       String
  gelezenOm   DateTime? // gelezen door de ontvanger
  createdAt   DateTime          @default(now())

  @@index([leerlingId, createdAt])
  @@index([rijschoolId, createdAt])
}

model RijschoolLes {
  id             String               @id @default(cuid())
  rijschoolId    String
  rijschool      Rijschool            @relation(fields: [rijschoolId], references: [id], onDelete: Cascade)
  leerlingId     String?
  leerling       RijschoolLeerling?   @relation(fields: [leerlingId], references: [id], onDelete: Cascade)
  instructeurId  String
  instructeur    RijschoolInstructeur @relation(fields: [instructeurId], references: [id], onDelete: Cascade)
  voertuigId     String?
  voertuig       RijschoolVoertuig?   @relation(fields: [voertuigId], references: [id], onDelete: SetNull)
  soort          RijschoolLesSoort    @default(LES)
  status         RijschoolLesStatus   @default(GEPLAND)
  start          DateTime
  eind           DateTime
  ophaaladres    String               @default("")
  // Leskaart: per onderdeel (lib/rijschool/leskaart.ts) een score 1–5 en een notitie.
  beoordeling    Json                 @default("{}")
  verslag        String               @default("") // zichtbaar voor de leerling
  huiswerk       String[]             @default([]) // onderdelen om thuis voor te bereiden
  interneNotitie String               @default("")
  gestartOm      DateTime?
  afgerondOm     DateTime?
  // Lesroute: de gereden route, opgenomen met de telefoon van de instructeur
  // (lib/rijschool/lesroute.ts). Alleen de leerling van deze les en de rijschool zien hem.
  route          Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tegoed RijschoolTegoed?

  @@index([rijschoolId, start])
  @@index([instructeurId, start])
  @@index([leerlingId, start])
}

// Lestegoed in minuten: + bij een betaald pakket of handmatig, − voor een
// gereden les. Het saldo is de som; lesId en betalingId zijn uniek, zodat een
// les of betaling nooit twee keer telt.
model RijschoolTegoed {
  id           String             @id @default(cuid())
  leerlingId   String
  leerling     RijschoolLeerling  @relation(fields: [leerlingId], references: [id], onDelete: Cascade)
  minuten      Int
  omschrijving String
  lesId        String?            @unique
  les          RijschoolLes?      @relation(fields: [lesId], references: [id], onDelete: SetNull)
  betalingId   String?            @unique
  betaling     RijschoolBetaling? @relation(fields: [betalingId], references: [id], onDelete: SetNull)
  door         String             @default("") // naam van wie het boekte; leeg = automatisch
  createdAt    DateTime           @default(now())

  @@index([leerlingId])
}

model RijschoolBetaling {
  id              String                  @id @default(cuid())
  rijschoolId     String
  rijschool       Rijschool               @relation(fields: [rijschoolId], references: [id], onDelete: Cascade)
  leerlingId      String
  leerling        RijschoolLeerling       @relation(fields: [leerlingId], references: [id], onDelete: Cascade)
  productId       String?
  product         RijschoolProduct?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  omschrijving    String
  bedragCent      Int
  status          RijschoolBetalingStatus @default(OPEN)
  methode         RijschoolBetaalMethode?
  stripeSessionId String?                 @unique
  betaaldOm       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tegoed RijschoolTegoed?

  @@index([rijschoolId, status])
  @@index([leerlingId])
}

// De Android-app van een rijschool, in haar eigen Google Play-account
// (lib/rijschool/app). ZekerFlex bouwt hem (deploy/android-bouwer) en beheert
// hem daarna via de Google Play-API: de rijschool nodigt het serviceaccount
// van ZekerFlex uit in haar Play Console.
model RijschoolApp {
  id                 String    @id @default(cuid())
  rijschoolId        String    @unique
  rijschool          Rijschool @relation(fields: [rijschoolId], references: [id], onDelete: Cascade)
  pakketnaam         String    @unique // ligt vast zodra de eerste versie in Google Play staat
  appNaam            String
  korteTekst         String    @default("") // winkelpagina, max. 80 tekens
  langeTekst         String    @default("") // winkelpagina, max. 4000 tekens
  versie             Int       @default(0) // versionCode van de laatst gebouwde versie
  sleutel            String? // uploadsleutel (keystore + wachtwoord), verzegeld (lib/security/sealed-secret)
  uploadVingerafdruk String? // SHA-256 van de uploadsleutel
  playVingerafdruk   String? // SHA-256 van de ondertekensleutel van Google, voor /.well-known/assetlinks.json
  aabUploadId        String? // de laatst gebouwde .aab, om de eerste keer zelf te uploaden
  testersGroep       String    @default("") // Google Group met de testers van de gesloten test
  gekoppeldOp        DateTime? // ZekerFlex kon de app in Google Play openen
  liveSinds          DateTime? // openbaar in de Play Store
  taakFase           String    @default("") // "", "bouwt", "verwerkt" of "fout" (lib/rijschool/app/taak.ts)
  taak               Json      @default("{}") // de lopende bouw of indiening
  sporen             Json      @default("{}") // laatst gelezen stand per spoor uit Google Play
  logboek            Json      @default("[]") // wat er gebeurde, nieuwste eerst
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Horeca-pakket. Een horecazaak is een gewoon ZekerFlex-bedrijf (Tenant) met de
// Horeca-module aan: eigen site met menukaart en reserveren op /horeca/<slug>,
// bestellen en afrekenen aan tafel via een QR-code, keuken- en barscherm en
// takenlijsten. Losse modules staan per zaak aan of uit (lib/horeca/modules.ts).
// De eigenaar beheert alles vanuit /werkgever/horeca. Zie lib/horeca.
// ---------------------------------------------------------------------------

enum HorecaBestellingStatus {
  NIEUW
  IN_BEREIDING
  KLAAR
  GESERVEERD
  GEANNULEERD
}

enum HorecaReserveringStatus {
  BEVESTIGD
  AANGEKOMEN
  NIET_GEKOMEN
  GEANNULEERD
}

enum HorecaBetalingStatus {
  OPEN
  BETAALD
  MISLUKT
}

model HorecaZaak {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug            String   @unique
  naam            String
  soort           String   @default("restaurant") // restaurant, cafe, lunchroom, bar, hotel
  plaats          String   @default("")
  adres           String   @default("")
  telefoon        String   @default("")
  email           String   @default("")
  kvk             String   @default("")
  kleur           String   @default("#0A120E")
  accent          String   @default("#FF5F1F")
  online          Boolean  @default(false) // site publiek; anders alleen zichtbaar voor de eigenaar
  // aangezette losse modules (lib/horeca/modules.ts)
  modules         String[] @default([])
  // weekdag (0 = zondag) -> { van, tot } in "UU:MM", of null = dicht
  openingstijden  Json     @default("{}")
  // reserveren: slotminuten, verblijfsduur, max. groep, dagen vooruit, couverts per slot
  reserveren      Json     @default("{}")
  // teksten van de website (kop, intro)
  website         Json     @default("{}")
  // kassa: btw-nummer op de bon en instellingen (voettekst, fooi) (lib/horeca/kassa.ts)
  btwNummer       String   @default("")
  kassa           Json     @default("{}")
  // Stripe Connect: het geld gaat rechtstreeks naar de zaak, niet via ZekerFlex.
  stripeAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tafels        HorecaTafel[]
  categorieen   HorecaCategorie[]
  items         HorecaItem[]
  bestellingen  HorecaBestelling[]
  betalingen    HorecaBetaling[]
  reserveringen HorecaReservering[]
  takenlijsten  HorecaTakenlijst[]
  oefenklussen  OefenKlus[]
}

model HorecaTafel {
  id        String     @id @default(cuid())
  zaakId    String
  zaak      HorecaZaak @relation(fields: [zaakId], references: [id], onDelete: Cascade)
  naam      String
  plaatsen  Int        @default(4)
  zone      String     @default("") // terras, binnen, bar
  // willekeurige code in de QR-link (/horeca/<slug>/tafel/<code>); nieuwe code = oude QR ongeldig
  code      String     @unique
  actief    Boolean    @default(true)
  volgorde  Int        @default(0)
  createdAt DateTime   @default(now())

  bestellingen  HorecaBestelling[]
  reserveringen HorecaReservering[]
  betalingen    HorecaBetaling[]

  @@index([zaakId])
}

model HorecaCategorie {
  id       String       @id @default(cuid())
  zaakId   String
  zaak     HorecaZaak   @relation(fields: [zaakId], references: [id], onDelete: Cascade)
  naam     String
  volgorde Int          @default(0)
  items    HorecaItem[]

  @@index([zaakId])
}

model HorecaItem {
  id           String           @id @default(cuid())
  zaakId       String
  zaak         HorecaZaak       @relation(fields: [zaakId], references: [id], onDelete: Cascade)
  categorieId  String?
  categorie    HorecaCategorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  naam         String
  omschrijving String           @default("")
  prijsCent    Int
  // de 14 wettelijke allergenen (lib/horeca/allergenen.ts)
  allergenen   String[]         @default([])
  vegetarisch  Boolean          @default(false)
  veganistisch Boolean          @default(false)
  beschikbaar  Boolean          @default(true) // uitverkocht = false
  station      String           @default("keuken") // keuken of bar: waar de bestelling heen gaat
  // btw-tarief in procenten (9 eten en alcoholvrij, 21 alcohol, 0)
  btw          Int              @default(9)
  // nog te verkopen stuks; null = onbeperkt. Op 0 is het gerecht vanzelf uitverkocht
  voorraad     Int?
  // keuzes bij het bestellen, bv. [{ naam: "Bakwijze", keuzes: ["Rare", "Medium"], verplicht: true }]
  opties       Json             @default("[]")
  volgorde     Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([zaakId])
}

model HorecaBestelling {
  id         String                 @id @default(cuid())
  zaakId     String
  zaak       HorecaZaak             @relation(fields: [zaakId], references: [id], onDelete: Cascade)
  tafelId    String?
  tafel      HorecaTafel?           @relation(fields: [tafelId], references: [id], onDelete: SetNull)
  // volgnummer per zaak, voor keuken en gast ("bestelling 42")
  nummer     Int
  status     HorecaBestellingStatus @default(NIEUW)
  // vastgelegd bij het bestellen: [{ itemId, naam, prijsCent, aantal, opmerking, station }]
  regels     Json
  totaalCent Int
  opmerking  String                 @default("")
  bron       String                 @default("qr") // qr (gast) of bediening
  naam       String                 @default("")
  betaald    Boolean                @default(false)
  betalingId String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([zaakId, nummer])
  @@index([zaakId, status])
  @@index([zaakId, createdAt])
}

model HorecaBetaling {
  id              String               @id @default(cuid())
  zaakId          String
  zaak            HorecaZaak           @relation(fields: [zaakId], references: [id], onDelete: Cascade)
  tafelId         String?
  tafel           HorecaTafel?         @relation(fields: [tafelId], references: [id], onDelete: SetNull)
  bedragCent      Int
  fooiCent        Int                  @default(0)
  status          HorecaBetalingStatus @default(OPEN)
  stripeSessionId String?              @unique
  // welke bestellingen met deze betaling zijn afgerekend
  bestellingIds   String[]             @default([])
  // kassa: pin, contant, ideal of overig; wie afrekende; wat er betaald werd (voor de bon en de btw)
  methode         String               @default("ideal")
  door            String               @default("")
  regels          Json                 @default("[]")
  // volgnummer van de bon per zaak
  bonNummer       Int?
  createdAt       DateTime             @default(now())
  betaaldOp       DateTime?

  @@unique([zaakId, bonNummer])
  @@index([zaakId, createdAt])
}

model HorecaReservering {
  id        String                  @id @default(cuid())
  zaakId    String
  zaak      HorecaZaak              @relation(fields: [zaakId], references: [id], onDelete: Cascade)
  tafelId   String?
  tafel     HorecaTafel?            @relation(fields: [tafelId], references: [id], onDelete: SetNull)
  datum     String // JJJJ-MM-DD (Nederlandse dag)
  tijd      String // UU:MM
  personen  Int
  naam      String
  email     String
  telefoon  String
  opmerking String                  @default("")
  status    HorecaReserveringStatus @default(BEVESTIGD)
  bron      String                  @default("online") // online (eigen site), agent (AI-assistent) of bediening
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([zaakId, datum])
}

model HorecaTakenlijst {
  id          String            @id @default(cuid())
  zaakId      String
  zaak        HorecaZaak        @relation(fields: [zaakId], references: [id], onDelete: Cascade)
  naam        String
  moment      String            @default("dagelijks") // opening, sluiting, dagelijks, wekelijks
  // [{ tekst, meten }]: meten = true vraagt een waarde (bv. temperatuur)
  taken       Json              @default("[]")
  volgorde    Int               @default(0)
  createdAt   DateTime          @default(now())
  afvinkingen HorecaAfvinking[]

  @@index([zaakId])
}

model HorecaAfvinking {
  id      String           @id @default(cuid())
  lijstId String
  lijst   HorecaTakenlijst @relation(fields: [lijstId], references: [id], onDelete: Cascade)
  datum   String // JJJJ-MM-DD
  taak    Int // plek in de lijst
  door    String
  waarde  String           @default("") // bv. "4,5 °C"
  op      DateTime         @default(now())

  @@unique([lijstId, datum, taak])
}

// ─────────────────────────────────────────────────────────── Domeinnamen
// Een domeinnaam die een bedrijf via ZekerFlex bestelt (lib/domeinen/bestelling.ts).
// Bewust zonder relatie met Tenant: een betaalde bestelling is een financieel
// gegeven en blijft bestaan als het bedrijf weg is (bewaarplicht).
enum DomeinBestelStatus {
  OPEN // wacht op betaling (Stripe Checkout)
  BETAALD // betaald of in de bundel; ZekerFlex registreert hem
  GEREGISTREERD // vastgelegd bij het register
  MISLUKT // registreren lukte niet (terugbetalen via Stripe)
  GEANNULEERD
  OPGEZEGD // niet verlengd: opgezegd bij het register, loopt af op verlooptOp (lib/domeinen/verlengen.ts)
}

model DomeinBestelling {
  id              String             @id @default(cuid())
  tenantId        String
  userId          String
  email           String // wie bestelde (bevestiging)
  domein          String
  jaren           Int                @default(1)
  prijsCent       Int // excl. btw; 0 in de bundel
  btwCent         Int
  bundel          Boolean            @default(false) // eerste jaar inbegrepen bij een websiteabonnement
  status          DomeinBestelStatus @default(OPEN)
  stripeSessionId String?            @unique
  betaaldOp       DateTime?
  afgerondOp      DateTime?
  notitie         String             @default("")
  // Verlengen (lib/domeinen/verlengen.ts): tot wanneer de naam loopt, of de klant hem elk jaar
  // wil verlengen, en wanneer hij (bij niet betalen of op verzoek) is opgezegd.
  verlooptOp      DateTime?
  autoVerlengen   Boolean            @default(true)
  opgezegdOp      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([domein])
  @@index([status, verlooptOp])
}

// ---------------------------------------------------------------------------
// Oefenklussen: praktijkshifts voor trainingen in de horeca-branche. Een zaak
// kan oefenklussen aanbieden waar vrijwilligers/trainees kunnen aanmelden.
// De zaak accepteert of weigert aanmeldingen en markeert deelnemers als afgerond.
// ---------------------------------------------------------------------------

enum OefenKlusAanmeldingStatus {
  AANGEMELD
  GEACCEPTEERD
  GEWEIGERD
  AFGEROND
  GEANNULEERD
}

model OefenKlus {
  id                String   @id @default(cuid())
  zaakId            String
  zaak              HorecaZaak @relation(fields: [zaakId], references: [id], onDelete: Cascade)
  titel             String
  beschrijving      String
  datum             DateTime // startdatum van de oefenklus
  startTijd         String   // "HH:MM"
  eindTijd          String   // "HH:MM"
  maxAanmeldingen   Int      @default(5)
  niveau            String   @default("beginner") // beginner, intermediate, advanced
  vereisten         String   @default("") // wat men moet weten
  actief            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  aanmeldingen OefenKlusAanmelding[]

  @@index([zaakId, actief])
  @@index([datum])
}

model OefenKlusAanmelding {
  id          String @id @default(cuid())
  oefenKlusId String
  oefenKlus   OefenKlus @relation(fields: [oefenKlusId], references: [id], onDelete: Cascade)

  voornaam   String
  achternaam String
  email      String
  telefoon   String @default("")
  ervaring   String // geen, minder-dan-1-jaar, 1-tot-3-jaar, meer-dan-3-jaar
  opmerkingen String @default("")

  status         OefenKlusAanmeldingStatus @default(AANGEMELD)
  notitieZaak    String @default("") // notitie van de zaak
  afgerondOp     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([oefenKlusId, email])
  @@index([oefenKlusId, status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Shift Favorites: flexwerkers kunnen klussen 'favoriet' markeren
// (bookmarken) voor makkelijke terugvinding en alerts op nieuwe uren
// bij dezelfde werkgever/locatie.
// ---------------------------------------------------------------------------

model ShiftFavorite {
  id              String @id @default(cuid())
  freelancerId    String
  freelancer      FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  shiftId         String
  shift           Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  // Notificatie-voorkeur: push bij vergelijkbare shifts?
  alertSimilar    Boolean @default(true)

  createdAt       DateTime @default(now())

  @@unique([freelancerId, shiftId])
  @@index([freelancerId])
  @@index([shiftId])
}

// ---------------------------------------------------------------------------
// Video Management: tutorials, walkthroughs, guides
// Real video hosting (Vimeo, YouTube, self-hosted) with analytics
// ---------------------------------------------------------------------------

model Video {
  id                String   @id @default(cuid())
  title             String
  description       String
  category          String   // tutorial | walkthrough | guide | story | faq
  role              String   // general | employer | worker | admin
  durationSeconds   Int
  thumbnailUrl      String
  hostedOn          String   // vimeo | youtube | self-hosted
  hostId            String
  qualities         String[] @default([]) // 360p | 720p | 1080p | 4K
  subtitles         Json     @default("[]") // [{language, url}]
  playlist          String?
  views             Int      @default(0)
  watchTime         Int      @default(0) // total seconds watched across all viewers
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([role])
  @@index([views])
  @@index([createdAt])
}

// ===========================================================================
// Marketplace Ecosystem
// ===========================================================================

enum AppStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  SUSPENDED
  REJECTED
}

enum AppCategory {
  INTEGRATION
  AUTOMATION
  REPORTING
  ANALYTICS
  PAYMENT
  COMMUNICATION
  PRODUCTIVITY
  SECURITY
  TRAINING
  CUSTOM
}

enum DeveloperTier {
  INDIVIDUAL
  STARTUP
  PROFESSIONAL
  ENTERPRISE
}

enum PartnerTier {
  SILVER
  GOLD
  PLATINUM
}

enum PartnerType {
  INTEGRATION
  RESELLER
  AGENCY
  CONSULTANT
  TECHNOLOGY
  TRAINING
  DATA
  RESEARCH
}

// Third-party applications in the marketplace
model MarketplaceApp {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String
  longDescription String?
  status          AppStatus   @default(DRAFT)
  category        AppCategory

  developerTenantId String
  developerTenant   Tenant @relation("AppDeveloper", fields: [developerTenantId], references: [id])

  logoUrl         String?
  bannerUrl       String?
  screenshots     Json? // array of URLs

  version         String      @default("1.0.0")
  currentVersion  String      @default("1.0.0")

  // OAuth
  oauthClientId   String
  oauthClientSecret String
  oauthRedirectUris Json // array of URLs

  // Scopes requested
  requestedScopes Json? // array of scope strings

  // Installation
  installationCount Int @default(0)
  activeInstallations Int @default(0)

  // Revenue
  monthlyRecurringRevenueCents Int @default(0)
  totalRevenueAllTimeCents Int @default(0)
  platformFeeBasisPoints Int @default(3000) // 30%

  // Ratings
  averageRating Float @default(0) // 0-5
  reviewCount Int @default(0)

  documentation String? // markdown
  supportUrl String?
  privacyPolicyUrl String?
  termsUrl String?

  // Webhook
  webhookSecret String? @unique
  webhookUrl String?

  isPublished Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installations MarketplaceAppInstallation[]
  reviews AppReview[]
  versions AppVersion[]
  analytics AppAnalytics[]
  events AppEvent[]

  @@index([developerTenantId])
  @@index([status])
  @@index([category])
  @@index([installationCount])
}

model AppVersion {
  id String @id @default(cuid())
  appId String
  app MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  version String
  description String?
  releaseNotes String?

  isCurrentVersion Boolean @default(false)
  releasedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([appId, version])
  @@index([appId])
}

model MarketplaceAppInstallation {
  id String @id @default(cuid())
  appId String
  app MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  tenantId String
  tenant Tenant @relation("AppInstallations", fields: [tenantId], references: [id])

  accessToken String @unique
  refreshToken String?
  scopes Json // array of scopes granted

  installationDate DateTime @default(now())
  lastAccessedAt DateTime?

  isActive Boolean @default(true)
  config Json? // app-specific config

  @@unique([appId, tenantId])
  @@index([appId])
  @@index([tenantId])
}

model AppReview {
  id String @id @default(cuid())
  appId String
  app MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  tenantId String
  tenant Tenant @relation("AppReviews", fields: [tenantId], references: [id])

  rating Int // 1-5
  title String
  content String

  isVerifiedPurchase Boolean @default(true)
  helpfulCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId])
  @@index([rating])
}

model AppAnalytics {
  id String @id @default(cuid())
  appId String
  app MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  date DateTime

  installs Int @default(0)
  uninstalls Int @default(0)
  activeUsers Int @default(0)
  events Int @default(0)

  revenueGeneratedCents Int @default(0)
  platformFeeCents Int @default(0)

  @@unique([appId, date])
  @@index([appId])
}

model AppEvent {
  id String @id @default(cuid())
  appId String
  app MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  type String // custom event type
  tenantId String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([appId, type])
}

// Developer portal access
model Developer {
  id String @id @default(cuid())
  tenantId String @unique
  tenant Tenant @relation("Developer", fields: [tenantId], references: [id])

  tier DeveloperTier @default(INDIVIDUAL)

  // API
  apiKeysCount Int @default(0)
  apiCallsThisMonth Int @default(0)
  apiCallsLimit Int @default(1000000)

  // Webhook
  webhooksCount Int @default(0)

  // Certification
  isCertified Boolean @default(false)
  certificationDate DateTime?

  // Profile
  companyName String?
  website String?
  supportEmail String
  documentation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier])
}

// Partner programs
model Partner {
  id String @id @default(cuid())
  tenantId String @unique
  tenant Tenant @relation("Partner", fields: [tenantId], references: [id])

  type PartnerType
  tier PartnerTier @default(SILVER)

  // Revenue sharing
  revenueSplitPercentage Int // 10, 20, 30 etc
  ytdRevenueShareCents Int @default(0)

  // Contact
  primaryContactEmail String
  supportEmail String?

  // Marketing
  coMarketingAllowed Boolean @default(true)
  exclusivityRegions Json? // array of region codes

  // Metrics
  customerCount Int @default(0)
  totalRevenueGeneratedCents Int @default(0)

  status String @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  joinedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([tier])
}

// Reseller accounts
model Reseller {
  id String @id @default(cuid())
  tenantId String @unique
  tenant Tenant @relation("Reseller", fields: [tenantId], references: [id])

  // Commission structure
  discountPercentage Int // 10-30%
  commissionPercentageBasisPoints Int // 500-3000

  // Territory
  territory String? // region code or country
  exclusiveTerritory Boolean @default(false)

  // Customers
  customerCount Int @default(0)
  totalRevenueGeneratedCents Int @default(0)

  // Contact
  contactEmail String
  supportEmail String?

  status String @default("ACTIVE")
  joinedAt DateTime @default(now())

  @@index([territory])
}

// Agency partners (implementation, consulting, training)
model Agency {
  id String @id @default(cuid())
  tenantId String @unique
  tenant Tenant @relation("Agency", fields: [tenantId], references: [id])

  // Services
  services Json // array: "IMPLEMENTATION", "CONSULTING", "TRAINING", "CUSTOM_DEVELOPMENT"

  // Performance
  certifiedImplementers Int @default(0)
  projectsCompleted Int @default(0)
  customersSatisfactionScore Float? // 0-5

  // Revenue
  totalRevenueGeneratedCents Int @default(0)

  // Credentials
  isCertified Boolean @default(false)
  certifications Json? // array of cert names/dates

  // Contact
  contactEmail String
  website String?

  status String @default("ACTIVE")
  joinedAt DateTime @default(now())

  @@index([services])
}

// Integration partnerships
model Integration {
  id String @id @default(cuid())
  name String
  slug String @unique

  // Type
  category String // CRM, PAYMENT, COMMUNICATION, etc
  type String // WEBHOOK, OAUTH, API, CUSTOM

  // Description
  description String
  documentation String?
  logoUrl String?

  // Configuration
  configSchema Json? // JSON schema for setup
  authMethod String // OAUTH, API_KEY, BASIC, CUSTOM

  // Endpoints
  webhookUrl String?
  apiBaseUrl String?

  // Status
  status String @default("ACTIVE") // ACTIVE, BETA, DEPRECATED

  // Usage
  tenantCount Int @default(0)
  dailyEventsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
}

// Extension marketplace
model Extension {
  id String @id @default(cuid())
  name String
  slug String @unique

  description String
  category String

  developerTenantId String
  developerTenant Tenant @relation("ExtensionDeveloper", fields: [developerTenantId], references: [id])

  code String // JavaScript code for extension
  codeHash String @unique

  version String @default("1.0.0")

  // Marketplace
  isPublished Boolean @default(false)
  installationCount Int @default(0)

  // Revenue
  isPaid Boolean @default(false)
  priceCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([developerTenantId])
  @@index([isPublished])
}

// Template marketplace
model Template {
  id String @id @default(cuid())
  name String
  description String

  category String // workflow, report, dashboard, form

  creatorTenantId String?
  creatorTenant Tenant? @relation("TemplateCreator", fields: [creatorTenantId], references: [id])

  content Json // template configuration

  isPublished Boolean @default(false)
  isPaid Boolean @default(false)
  priceCents Int?

  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
}

// Add-ons system
model AddOn {
  id String @id @default(cuid())
  name String
  description String
  type String // FEATURE, CAPACITY, SUPPORT, TRAINING, CUSTOM

  category String

  basePriceCents Int // monthly
  billingPeriod String @default("MONTHLY")

  features Json? // array of features unlocked

  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

// Tenant's active add-ons
model TenantAddOn {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation("TenantAddOns", fields: [tenantId], references: [id])

  addOnId String
  addOn AddOn @relation(fields: [addOnId], references: [id])

  quantity Int @default(1)
  priceCents Int // locked price at purchase

  activeSince DateTime @default(now())
  renewsAt DateTime?

  @@unique([tenantId, addOnId])
  @@index([tenantId])
}

// Data exchange partnerships
model DataExchange {
  id String @id @default(cuid())
  name String
  description String

  providerTenantId String
  providerTenant Tenant @relation("DataExchangeProvider", fields: [providerTenantId], references: [id])

  consumerTenantId String
  consumerTenant Tenant @relation("DataExchangeConsumer", fields: [consumerTenantId], references: [id])

  dataType String // what data is being exchanged
  encryptionKey String?

  status String @default("PENDING") // PENDING, ACTIVE, TERMINATED

  revenueSharePercentage Int? // if data has direct revenue
  totalValueExchangedCents Int @default(0)

  agreedAt DateTime?
  startedAt DateTime?
  endedAt DateTime?

  @@unique([providerTenantId, consumerTenantId, dataType])
  @@index([providerTenantId])
  @@index([status])
}

// Certification program
model Certification {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String

  level Int @default(1) // 1-5
  prerequisites String? // prerequisite cert IDs

  courseUrl String?
  examUrl String?

  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([level])
}

model UserCertification {
  id String @id @default(cuid())
  userId String
  user User @relation("UserCertifications", fields: [userId], references: [id])

  certificationId String
  certification Certification @relation(fields: [certificationId], references: [id])

  earnedAt DateTime @default(now())
  expiresAt DateTime?
  certificateUrl String?

  @@unique([userId, certificationId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// HD Gallery: Media library with HD support, chunked uploads, analytics
// Supports images, videos, audio files with full-quality preservation
// ---------------------------------------------------------------------------

model Gallery {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items             GalleryItem[]

  totalSize         Int      @default(0) // total bytes
  itemCount         Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model GalleryItem {
  id                String   @id @default(cuid())
  galleryId         String
  gallery           Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  name              String
  description       String?

  url               String   // Storage path or external URL
  type              String   // image | video | audio
  mimeType          String

  width             Int?     // for images/videos
  height            Int?     // for images/videos
  duration          Int?     // in seconds, for videos/audio

  size              Int      // in bytes
  contentHash       String?  // SHA256 for duplicate detection

  tags              String[] @default([])
  collections       String[] @default([])

  viewCount         Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([galleryId])
  @@index([type])
  @@index([viewCount])
  @@index([createdAt])
  @@index([contentHash])
}

// ---------------------------------------------------------------------------
// Real-time Features: Presence, Chat, Live Data
// ---------------------------------------------------------------------------

model UserPresence {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  status    String   @default("offline") // online, away, offline, in-call
  device    String   @default("desktop") // desktop, mobile
  lastSeen  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  REACTION
  SYSTEM
}

model ChatMessage {
  id        String            @id @default(cuid())
  threadId  String
  senderId  String
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content   String
  type      ChatMessageType   @default(TEXT)

  reactions MessageReaction[]

  editedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  emoji     String
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, emoji, userId])
  @@index([messageId])
  @@index([userId])
}

// ===========================================================================
// Email Marketing
// ===========================================================================

enum EmailTemplateType {
  WELCOME
  PROMOTIONAL
  TRANSACTIONAL
  DRIP
  ABANDONED_CART
  WIN_BACK
  CUSTOM
}

model EmailTemplate {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  type      EmailTemplateType
  subject   String
  htmlBody  String
  textBody  String?
  variables Json @default("{}")

  abtestVariantA String?
  abtestVariantB String?
  darkModeStyles Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns EmailCampaign[] @relation("TemplateOnCampaign")

  @@index([tenantId])
  @@index([type])
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  FAILED
}

model EmailCampaign {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  status    EmailCampaignStatus @default(DRAFT)
  templateId String
  template  EmailTemplate @relation("TemplateOnCampaign", fields: [templateId], references: [id])

  listId    String?
  list      EmailList? @relation(fields: [listId], references: [id])

  segmentFilter Json? // Segment criteria
  scheduledAt DateTime?
  sentAt DateTime?

  recipientCount Int @default(0)
  openCount Int @default(0)
  clickCount Int @default(0)
  bounceCount Int @default(0)
  conversionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sends EmailSend[]
  automations EmailAutomation[] @relation("CampaignAutomations")

  @@index([tenantId])
  @@index([status])
  @@index([scheduledAt])
}

enum EmailListType {
  SUBSCRIBERS
  CUSTOMERS
  PROSPECTS
  CUSTOM
}

model EmailList {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  type      EmailListType
  description String?

  subscriberCount Int @default(0)
  activeCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscribers EmailSubscriber[]
  campaigns EmailCampaign[]

  @@index([tenantId])
  @@index([type])
}

enum EmailSubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  INACTIVE
}

model EmailSubscriber {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  listId    String
  list      EmailList @relation(fields: [listId], references: [id], onDelete: Cascade)

  email     String
  status    EmailSubscriberStatus @default(SUBSCRIBED)

  firstName String?
  lastName String?
  metadata  Json @default("{}")

  consentGiven Boolean @default(true)
  consentDate DateTime?

  engagementScore Int @default(0)
  lastEngagementAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sends EmailSend[]

  @@unique([listId, email])
  @@index([tenantId])
  @@index([status])
}

model EmailSend {
  id        String @id @default(cuid())
  campaignId String
  campaign  EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  subscriberId String
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  email     String
  status    EmailSubscriberStatus

  opened    Boolean @default(false)
  openedAt  DateTime?

  clicked   Boolean @default(false)
  clickedAt DateTime?

  bounced   Boolean @default(false)
  bouncedAt DateTime?
  bounceReason String?

  converted Boolean @default(false)
  convertedAt DateTime?

  externalId String? // Provider message ID

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([subscriberId])
  @@index([status])
  @@index([openedAt])
}

enum EmailAutomationType {
  WELCOME_SERIES
  ABANDONED_CART
  WIN_BACK
  RE_ENGAGEMENT
  UPSELL
  POST_PURCHASE
  CUSTOM
}

model EmailAutomation {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  type      EmailAutomationType
  enabled   Boolean @default(true)

  triggerEvent String // Event name (e.g., "user.signup")
  triggerDelay Int? // Minutes delay before first email

  campaignId String?
  campaign   EmailCampaign? @relation("CampaignAutomations", fields: [campaignId], references: [id])

  sequence  Int @default(0) // Position in workflow
  nextAutomationId String? // Next step in workflow

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([type])
  @@index([enabled])
}

// ---------------------------------------------------------------------------
// CRM: Contacts, Deals, Activities, Sales Pipeline
// ---------------------------------------------------------------------------

model CrmContact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  email     String?
  phone     String?
  company   String?
  title     String?

  customFields  Json     @default("{}")
  tags          String[] @default([])

  deals         CrmDeal[]
  activities    CrmActivity[]
  notes         CrmNote[]

  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([createdAt])
}

enum DealStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model CrmDeal {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  valueCents    Int       // deal value in cents
  stage         DealStage @default(PROSPECT)
  probability   Int       @default(50) // 0-100%

  wonAt         DateTime?
  lostAt        DateTime?
  lostReason    String?

  activities    CrmActivity[]

  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, stage])
  @@index([contactId])
  @@index([createdAt])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

model CrmActivity {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   CrmContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  dealId    String?
  deal      CrmDeal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  type      ActivityType
  title     String
  notes     String?
  duration  Int?         // in minutes

  dueDate   DateTime?
  completed DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@index([dealId])
  @@index([dueDate])
  @@index([createdAt])
}

model CrmNote {
  id        String     @id @default(cuid())
  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  content   String

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([createdAt])
}

// ===========================================================================
// Project Management
// ===========================================================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      ProjectStatus @default(PLANNING)

  startDate   DateTime
  dueDate     DateTime?
  completedAt DateTime?

  budget      Int?     // cents
  spent       Int @default(0)

  owner       String   // userId
  members     ProjectMember[]
  tasks       Task[]
  timeline    ProjectTimeline?
  reports     ProjectReport[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([startDate])
  @@index([dueDate])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId    String
  role      String   // owner, manager, member, viewer
  hours     Int?     // estimated hours

  @@unique([projectId, userId])
  @@index([projectId])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assignedTo  String?  // userId
  dependencies Task[]   @relation("TaskDependencies_from")
  dependentTasks Task[]   @relation("TaskDependencies_from")

  estimatedHours Int?
  actualHours    Int @default(0)

  subtasks    Subtask[]
  checklist   ChecklistItem[]
  attachments TaskAttachment[]
  comments    TaskComment[]

  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?

  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([dueDate])
}

model Subtask {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title       String
  completed   Boolean @default(false)
  order       Int

  @@index([taskId])
}

model ChecklistItem {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  label       String
  completed   Boolean @default(false)
  order       Int

  @@index([taskId])
}

model TaskAttachment {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String

  uploadedBy  String
  uploadedAt  DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  content     String
  mentions    String[] @default([]) // userId list
  attachments String[] @default([]) // URL list

  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([createdAt])
}

model ProjectTimeline {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestones  ProjectMilestone[]
  criticalPath String? // JSON path of task IDs
  variance    Int? // days

  @@index([projectId])
}

model ProjectMilestone {
  id        String   @id @default(cuid())
  timelineId String
  timeline  ProjectTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  name      String
  dueDate   DateTime
  completed Boolean @default(false)

  @@index([timelineId])
  @@index([dueDate])
}

model ProjectReport {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      String   // burndown, resource_util, budget_var, velocity
  data      Json     // report data
  generatedAt DateTime @default(now())

  @@index([projectId])
  @@index([type])
}

// ===========================================================================
// Surveys & Feedback
// ===========================================================================

model Survey {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        String   // nps, feedback, custom
  status      String   @default("draft") // draft, active, closed

  questions   SurveyQuestion[]
  responses   SurveyResponse[]

  startDate   DateTime?
  endDate     DateTime?

  abtesting   Boolean  @default(false)
  variant     String?  // A or B for A/B testing

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([type])
}

model SurveyQuestion {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        String   // text, multiple_choice, rating, nps, likert
  required    Boolean  @default(true)

  options     String[] @default([]) // JSON for multiple choice
  conditional Json?    // branching logic

  order       Int

  answers     SurveyAnswer[]

  @@index([surveyId])
  @@index([order])
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  userId      String?
  email       String?
  anonymous   Boolean  @default(false)

  answers     SurveyAnswer[]

  sentiment   String?  // positive, neutral, negative
  npsScore    Int?     // 0-10

  startedAt   DateTime @default(now())
  completedAt DateTime?

  metadata    Json?    // device, location, etc

  @@index([surveyId])
  @@index([userId])
  @@index([email])
  @@index([npsScore])
  @@index([sentiment])
}

model SurveyAnswer {
  id          String   @id @default(cuid())
  questionId  String
  question    SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  value       String   // text answer
  numValue    Int?     // numeric rating

  createdAt   DateTime @default(now())

  @@index([questionId])
  @@index([responseId])
}

model Feedback {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId      String?
  email       String?

  type        String   // bug, feature_request, general
  message     String

  sentiment   String?  // positive, neutral, negative
  category    String?  // extracted from message

  status      String   @default("new") // new, acknowledged, resolved, archived

  attachments String[] @default([]) // URLs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([sentiment])
}

model NpsTracking {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  score       Int      // 0-10
  segment     String   // promoter, passive, detractor

  userId      String?
  email       String?

  comment     String?
  followUp    String?  // follow up workflow status

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([segment])
  @@index([score])
  @@index([userId])
}

model FeedbackWidget {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  message     String
  buttonText  String   @default("Send Feedback")

  type        String   // modal, sidebar, embedded
  position    String?  // bottom_right, bottom_left, etc

  enabled     Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// ===========================================================================
// Inventory Management
// ===========================================================================

model InventoryProduct {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation("InventoryProducts", fields: [tenantId], references: [id], onDelete: Cascade)

  sku          String   @unique
  name         String
  description  String?
  category     String   // category slug
  priceCents   Int      // base price in cents
  cost         Int?     // cost in cents

  // Variants & bundling
  variants     String[] @default([]) // array of variant names (size, color, etc)
  isBundled    Boolean  @default(false)
  bundleItems  String[] @default([]) // array of SKUs in bundle

  // Custom fields (JSON)
  customFields Json     @default("{}")

  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stock        InventoryStock?
  movements    InventoryMovement[]
  purchaseOrders InventoryPurchaseOrder[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([category])
  @@index([archived])
}

model InventoryStock {
  id        String   @id @default(cuid())
  productId String   @unique
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  currentLevel Int      @default(0) // units in stock
  reorderPoint Int      @default(0) // auto-order at this level
  reorderQty   Int      @default(0) // quantity to order

  // Warehouse locations & tracking
  warehouseLocation String? // bin/rack/shelf location
  lotNumber        String? // batch/lot tracking
  serialNumbers    String[] @default([]) // individual serial numbers
  expirationDate   DateTime? // expiration date if applicable

  lastStockCheck   DateTime?
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([warehouseLocation])
  @@index([expirationDate])
}

enum InventoryMovementType {
  PURCHASE     // stock in
  SALE         // stock out
  ADJUSTMENT   // manual adjustment
  TRANSFER     // warehouse transfer
  WRITE_OFF    // loss/damage
  RETURN       // customer return
}

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  tenantId  String
  tenant    Tenant   @relation("InventoryMovements", fields: [tenantId], references: [id], onDelete: Cascade)

  type      InventoryMovementType
  quantity  Int      // positive or negative
  reference String?  // PO/SO/invoice number
  notes     String?

  createdAt DateTime @default(now())
  createdBy String?  // user who made the movement

  @@index([productId])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

model InventorySupplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation("InventorySuppliers", fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?

  leadTimeDays  Int      @default(7)
  minimumOrder  Int      @default(1)
  paymentTerms  String?  // net 30, net 60, etc

  purchaseOrders InventoryPurchaseOrder[]
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([name])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model InventoryPurchaseOrder {
  id        String   @id @default(cuid())
  productId String
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   InventorySupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  tenantId  String
  tenant    Tenant   @relation("InventoryPurchaseOrders", fields: [tenantId], references: [id], onDelete: Cascade)

  poNumber      String   @unique
  status        PurchaseOrderStatus @default(DRAFT)

  quantity      Int
  unitCostCents Int      // cost in cents
  totalCostCents Int     // total in cents

  orderedDate   DateTime @default(now())
  expectedDate  DateTime?
  receivedDate  DateTime?

  notes         String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([supplierId])
  @@index([tenantId])
  @@index([status])
  @@index([expectedDate])
}

model InventoryForecast {
  id        String   @id @default(cuid())
  productId String   @unique
  tenantId  String

  // Demand forecast
  forecastQty   Int      // predicted demand
  forecastDate  DateTime // for what period

  // Historical data for prediction
  trend         Float    // trend coefficient
  seasonality   Float    // seasonal adjustment
  avgSales      Int      // average daily sales
  volatility    Float    // demand volatility

  // Predictions
  predictedStockOut DateTime? // when we'll run out
  recommendedReorder Int?     // recommended order qty

  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([forecastDate])
}

model InventoryReport {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation("InventoryReports", fields: [tenantId], references: [id], onDelete: Cascade)

  type      String   // valuation, turnover, aging, waste, supplier, cost
  data      Json     // report data
  generatedAt DateTime @default(now())

  @@index([tenantId])
  @@index([type])
  @@index([generatedAt])
}

// ===========================================================================
// HR & Payroll
// ===========================================================================

model Employee {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation("Employees", fields: [tenantId], references: [id], onDelete: Cascade)

  firstName       String
  lastName        String
  email           String
  phone           String?
  department      String
  position        String
  hireDate        DateTime
  employmentType  String   // FULL_TIME, PART_TIME, CONTRACT, INTERN
  manager         String?
  emergencyContact Json?
  status          String   @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  terminationDate DateTime?

  salarySetup     SalarySetup?
  attendance      Attendance[]
  reviews         PerformanceReview[]
  goals           EmployeeGoal[]
  compliance      ComplianceDocument[]
  training        Training[]
  backgroundCheck BackgroundCheck[]
  feedback        Feedback[]
  slips           SalarySlip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([department])
}

model SalarySetup {
  id                    String @id @default(cuid())
  employeeId            String @unique
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  baseSalary            Int    // in cents
  taxRate               Float  @default(0.2)
  socialSecurityRate    Float  @default(0.12)
  healthInsuranceCents  Int?
  otherDeductionsCents  Int?
  currency              String @default("EUR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalarySlip {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId      String

  periodStart   DateTime
  periodEnd     DateTime
  grossSalary   Int
  netSalary     Int
  deductions    Json
  currency      String
  generatedAt   DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
  @@index([generatedAt])
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId      String

  date          String   // YYYY-MM-DD
  checkInTime   DateTime
  checkOutTime  DateTime?
  status        String   // PRESENT, ABSENT, LATE, HALF_DAY, LEAVE
  notes         String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
}

model PerformanceReview {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId        String

  rating          Int      // 1-5
  comments        String
  goals           Json     // array
  developmentAreas Json    // array
  reviewers       Json     // array of reviewer IDs
  reviewDate      DateTime

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

model EmployeeGoal {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId        String

  title           String
  description     String
  dueDate         DateTime
  priority        String   // LOW, MEDIUM, HIGH
  status          String   @default("ACTIVE")
  progress        Int      @default(0) // 0-100
  notes           String?
  lastUpdated     DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

model ComplianceDocument {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId        String

  documentType    String   // CONTRACT, NDA, POLICY, TRAINING, CERT
  documentUrl     String
  expiryDate      DateTime?
  status          String   // PENDING, ACKNOWLEDGED, EXPIRED
  acknowledgedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

model Training {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId        String

  courseName      String
  provider        String
  completionDate  DateTime
  certificate     String   // URL

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

model BackgroundCheck {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId        String

  checkType       String   // CRIMINAL, REFERENCE, EMPLOYMENT, OTHER
  status          String   // PENDING, APPROVED, FLAGGED
  notes           String?
  checkedAt       DateTime

  @@index([tenantId])
  @@index([employeeId])
}

model Feedback {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId        String

  fromEmployeeId  String
  rating          Int
  comments        String
  isAnonymous     Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

// ===========================================================================
// Affiliate & Referral Program
// ===========================================================================

model Affiliate {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation("AffiliateUser", fields: [userId], references: [id], onDelete: Cascade)

  code              String   @unique
  name              String
  email             String   @unique
  status            String   @default("PENDING") // PENDING, APPROVED, SUSPENDED
  commissionRate    Int      @default(10) // percentage
  tier              String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM

  totalEarnings     Int      @default(0) // in cents
  totalConversions  Int      @default(0)
  lastPayoutAt      DateTime?

  trackings         Tracking[]
  commissions       Commission[]
  payouts           Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Referral {
  id                String   @id @default(cuid())
  referrerId        String
  referrer          User     @relation("ReferralUser", fields: [referrerId], references: [id], onDelete: Cascade)

  referredUserId    String?

  code              String   @unique
  link              String   @unique
  status            String   @default("ACTIVE") // ACTIVE, CONVERTED, EXPIRED
  reward            Int      // in cents
  rewardType        String   @default("CREDIT") // CREDIT, DISCOUNT, CASH

  expiresAt         DateTime?
  convertedAt       DateTime?
  claimedAt         DateTime?

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@index([status])
}

model Tracking {
  id                String   @id @default(cuid())
  affiliateId       String
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  userId            String?

  trackingCode      String   @unique
  utm               Json     // { source, medium, campaign, content }
  deviceId          String

  firstClick        DateTime
  lastClick         DateTime
  converted         Boolean  @default(false)
  conversionValue   Int      @default(0) // in cents
  commission        Int      @default(0) // in cents

  attributionModel  String   @default("LAST_CLICK") // FIRST_CLICK, LAST_CLICK, LINEAR, POSITION_BASED

  createdAt DateTime @default(now())

  @@index([affiliateId])
  @@index([converted])
}

model Commission {
  id                String   @id @default(cuid())
  affiliateId       String
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  trackingId        String
  tracking          Tracking? @relation(fields: [trackingId], references: [id])

  amount            Int      // in cents
  status            String   @default("PENDING") // PENDING, APPROVED, PAID, DISPUTED

  payoutId          String?
  payout            Payout?  @relation(fields: [payoutId], references: [id])

  payoutDate        DateTime?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
}

model Payout {
  id                String   @id @default(cuid())
  affiliateId       String
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  amount            Int      // in cents
  status            String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED

  commissions       Commission[]

  createdAt DateTime @default(now())
  completedAt       DateTime?

  @@index([affiliateId])
  @@index([status])
}


// ===========================================================================
// Invoicing & Accounting
// ===========================================================================

model Invoice {
  id                  String   @id @default(cuid())
  invoiceNumber       String   @unique
  issuerId            String
  issuer              Tenant   @relation("InvoiceIssuer", fields: [issuerId], references: [id])
  recipientId         String
  recipient           Tenant   @relation("InvoiceRecipient", fields: [recipientId], references: [id])

  issuedAt            DateTime
  dueDate             DateTime
  amountCents         Int      // in cents to avoid floating point
  currencyCode        String   @default("EUR")
  paidCents           Int?     // amount paid so far
  description         String?

  status              String   @default("DRAFT") // DRAFT, SENT, UNPAID, PARTIALLY_PAID, PAID
  paymentTerms        String   @default("NET_30") // NET_15, NET_30, NET_60, NET_90, IMMEDIATE
  recurringFrequency  String   @default("ONCE") // ONCE, MONTHLY, QUARTERLY, ANNUALLY

  sentAt              DateTime?
  paidAt              DateTime?

  payments            Payment[]
  reminders           PaymentReminder[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([issuerId])
  @@index([recipientId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id                  String   @id @default(cuid())
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountCents         Int
  paymentMethod       String   // BANK_TRANSFER, CARD, CASH, CHECK
  reference           String?
  paidAt              DateTime @default(now())

  createdAt           DateTime @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model PaymentReminder {
  id                  String   @id @default(cuid())
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sentAt              DateTime @default(now())
  reminderNumber      Int      @default(1)

  @@index([invoiceId])
}

model Refund {
  id                  String   @id @default(cuid())
  invoiceId           String
  amountCents         Int
  reason              String
  processedAt         DateTime @default(now())

  @@index([invoiceId])
}

model Expense {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId              String?
  amountCents         Int
  category            String   // TRAVEL, MEALS, SUPPLIES, EQUIPMENT, UTILITIES, OTHER
  description         String
  date                DateTime

  taxCategory         String?
  mileage             Float?   // in km
  receiptUrl          String?

  status              String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?

  reimbursedAt        DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([date])
  @@index([status])
}

model JournalEntry {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  date                DateTime
  description         String
  referenceId         String?  // invoice, payment, etc

  ledgerLines         LedgerLine[]

  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([date])
}

model LedgerLine {
  id                  String   @id @default(cuid())
  entryId             String
  entry               JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountNumber       String   // e.g., "1000" for Assets
  debitCents          Int      @default(0)
  creditCents         Int      @default(0)

  @@index([entryId])
  @@index([accountNumber])
}

model TaxPayment {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  amountCents         Int
  paymentDate         DateTime
  dueDate             DateTime

  periodType          String   // QUARTERLY, MONTHLY
  period              Int      // 1-4 for quarterly, 1-12 for monthly
  year                Int

  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([year])
}

// ===========================================================================
// Calendar & Scheduling
// ===========================================================================

model Calendar {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  color       String?
  description String?
  isShared    Boolean @default(false)

  events      CalendarEvent[]
  shares      CalendarShare[]
  integrations CalendarIntegration[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CalendarEvent {
  id          String @id @default(cuid())
  calendarId  String
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  title       String
  description String?
  startTime   DateTime
  endTime     DateTime

  isRecurring Boolean @default(false)
  recurrenceRule String?
  reminders   Int[] @default([15])

  externalEventId String?
  externalProvider String? // "google", "outlook", "apple"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([calendarId])
  @@index([startTime])
  @@index([externalEventId])
}

model CalendarShare {
  id          String @id @default(cuid())
  calendarId  String
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User @relation("CalendarShares", fields: [targetUserId], references: [id], onDelete: Cascade)

  permission  String @default("view") // "view" | "edit"

  createdAt   DateTime @default(now())

  @@unique([calendarId, targetUserId])
  @@index([targetUserId])
}

model CalendarIntegration {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  calendarId  String
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  provider    String // "google" | "outlook" | "ical" | "apple"
  accessToken String?
  refreshToken String?
  externalId  String?

  lastSyncedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([calendarId])
}

model UserAvailability {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workingHours Json @default("{}")
  bufferMinutes Int @default(15)
  bufferPosition String @default("after") // "before" | "after"

  meetingFreeStart Int? // hour (0-23)
  meetingFreeEnd   Int?

  blocks      AvailabilityBlock[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AvailabilityBlock {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String // "vacation" | "focus" | "block"
  title       String

  startDate   DateTime?
  endDate     DateTime?

  dayOfWeek   Int? // 0-6
  startTime   String? // "09:00"
  endTime     String? // "17:00"

  availability UserAvailability @relation(fields: [userId], references: [userId], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
}

model RoomReservation {
  id          String @id @default(cuid())
  roomId      String

  startTime   DateTime
  endTime     DateTime

  meetingId   String?

  createdAt   DateTime @default(now())

  @@index([roomId])
  @@index([startTime])
}
  @@index([periodType])
}

// ===========================================================================
// Digital Asset Management (DAM)
// ===========================================================================

model DamAsset {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("DamAssets", fields: [tenantId], references: [id], onDelete: Cascade)

  name                String
  description         String?
  type                String   // IMAGE, VIDEO, DOCUMENT, AUDIO, OTHER
  mimeType            String
  fileSize            Int
  url                 String
  thumbnailUrl        String?

  folderId            String?
  folder              DamFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  tags                String[] @default([])
  metadata            Json?

  versions            DamAssetVersion[]
  shares              DamAssetShare[]
  publicLinks         DamPublicLink[]
  downloads           DamDownloadLog[]
  collectionAssets    DamCollectionAsset[]

  uploadedBy          String
  uploadedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
  archivedAt          DateTime?

  @@index([tenantId])
  @@index([folderId])
  @@index([uploadedAt])
  @@index([archivedAt])
}

model DamAssetVersion {
  id                  String   @id @default(cuid())
  assetId             String
  asset               DamAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  version             Int
  url                 String

  createdAt           DateTime @default(now())

  @@index([assetId])
  @@unique([assetId, version])
}

model DamFolder {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("DamFolders", fields: [tenantId], references: [id], onDelete: Cascade)

  name                String
  parentId            String?
  parent              DamFolder? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children            DamFolder[] @relation("FolderHierarchy")

  assets              DamAsset[]
  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([parentId])
}

model DamAssetShare {
  id                  String   @id @default(cuid())
  assetId             String
  asset               DamAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  userId              String
  permission          String   // VIEW, DOWNLOAD, EDIT, MANAGE

  sharedAt            DateTime @default(now())

  @@index([assetId])
  @@index([userId])
  @@unique([assetId, userId])
}

model DamPublicLink {
  id                  String   @id @default(cuid())
  token               String   @unique @default(cuid())
  assetId             String
  asset               DamAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  downloads           Int      @default(0)
  expiresAt           DateTime?
  createdAt           DateTime @default(now())
  lastAccessedAt      DateTime?

  @@index([assetId])
  @@index([token])
  @@index([expiresAt])
}

model DamDownloadLog {
  id                  String   @id @default(cuid())
  assetId             String
  asset               DamAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  userId              String?
  downloadedAt        DateTime @default(now())

  @@index([assetId])
  @@index([userId])
  @@index([downloadedAt])
}

model DamCollection {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("DamCollections", fields: [tenantId], references: [id], onDelete: Cascade)

  name                String
  description         String?
  isSmart             Boolean  @default(false)
  rules               Json?

  assets              DamCollectionAsset[]
  comments            DamCollectionComment[]
  shares              DamCollectionShare[]

  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

model DamCollectionAsset {
  id                  String   @id @default(cuid())
  collectionId        String
  collection          DamCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  assetId             String
  asset               DamAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  addedAt             DateTime @default(now())

  @@index([collectionId])
  @@index([assetId])
  @@unique([collectionId, assetId])
}

model DamCollectionComment {
  id                  String   @id @default(cuid())
  collectionId        String
  collection          DamCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  userId              String
  text                String

  createdAt           DateTime @default(now())

  @@index([collectionId])
  @@index([userId])
}

model DamCollectionShare {
  id                  String   @id @default(cuid())
  collectionId        String
  collection          DamCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  userId              String
  permission          String   // VIEW, EDIT

  sharedAt            DateTime @default(now())

  @@index([collectionId])
  @@index([userId])
  @@unique([collectionId, userId])
}

// ===========================================================================
// Custom Fields & Forms
// ===========================================================================

model CustomField {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  label       String
  type        String   // text, number, email, select, etc.
  required    Boolean  @default(false)
  disabled    Boolean  @default(false)
  hidden      Boolean  @default(false)
  helpText    String?
  placeholder String?
  defaultValue String?

  // JSON fields for complex data
  options     String?  // JSON array of FieldOption
  validation  String?  // JSON for FieldValidation
  conditional String?  // JSON for ConditionalDisplay
  metadata    String?  // JSON metadata

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([type])
}

model Form {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  title       String
  description String?

  // JSON fields for complex data
  fields      String   @default("[]") // JSON array of FormField
  sections    String   @default("[]") // JSON array of FormSection
  settings    String   @default("{}") // JSON for FormSettings

  responses   FormResponse[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([name])
}

model FormResponse {
  id          String   @id @default(cuid())
  formId      String
  tenantId    String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  data        String   // JSON object of field responses
  dataHash    String   // SHA256 for duplicate detection

  ip          String?  // Requester IP
  userAgent   String?  // Browser user agent

  submittedAt DateTime @default(now())

  @@index([formId])
  @@index([tenantId])
  @@index([dataHash])
  @@index([submittedAt])
}

// ===========================================================================
// Compliance & Audit
// ===========================================================================

model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  resource      String
  resourceId    String
  changes       String?  // JSON for field changes

  ipAddress     String
  userAgent     String
  status        String   // SUCCESS | FAILURE
  reason        String?
  metadata      String?  // JSON metadata

  hash          String   @unique
  previousHash  String?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
}

model DataGovernance {
  id                String   @id @default(cuid())
  dataType          String   @unique
  classification    String   // PUBLIC, INTERNAL, CONFIDENTIAL, RESTRICTED, PERSONAL, SENSITIVE
  retentionDays     Int
  residency         String   // EU, US, ANY, SAME_AS_STORAGE
  requiresEncryption Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([classification])
  @@index([dataType])
}

model DataDeletion {
  id              String   @id @default(cuid())
  dataType        String
  recordId        String
  scheduledDate   DateTime
  status          String   // PENDING, COMPLETED, FAILED
  error           String?
  completedAt     DateTime?

  createdAt       DateTime @default(now())

  @@index([dataType])
  @@index([status])
  @@index([scheduledDate])
}

model AccessGrant {
  id          String   @id @default(cuid())
  userId      String
  resource    String
  action      String
  expiresAt   DateTime?
  grantedAt   DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([expiresAt])
}

model AccessPolicy {
  id          String   @id @default(cuid())
  name        String
  type        String   // RBAC, ABAC, PBAC
  rules       String   // JSON array of rules
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([active])
}

model RiskAssessment {
  id                    String   @id @default(cuid())
  title                 String
  description           String
  category              String
  likelihood            Int      // 1-5
  impact                Int      // 1-5
  severity              String   // CRITICAL, HIGH, MEDIUM, LOW
  score                 Int      // 1-25
  status                String   // OPEN, IN_PROGRESS, MITIGATED, ACCEPTED, RESOLVED
  owner                 String?
  mitigationStrategy    String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([severity])
  @@index([status])
  @@index([category])
}

model Incident {
  id            String   @id @default(cuid())
  incidentId    String
  severity      String   // CRITICAL, HIGH, MEDIUM, LOW
  description   String
  status        String   // OPEN, INVESTIGATING, RESOLVED
  reportedAt    DateTime
  resolvedAt    DateTime?

  createdAt     DateTime @default(now())

  @@index([severity])
  @@index([status])
  @@index([reportedAt])
}

model GdprConsent {
  id            String   @id @default(cuid())
  userId        String
  consentType   String   // marketing, analytics, profiling
  value         Boolean
  consentDate   DateTime
  revokeDate    DateTime?
  ipAddress     String?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([consentType])
}

// ===========================================================================
// Live Streaming System
// ===========================================================================

enum StreamStatus {
  OFFLINE
  LIVE
  SCHEDULED
  ARCHIVED
}

enum RecordingStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model LiveStream {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation("StreamUser", fields: [userId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  category            String?
  tags                String[]
  streamKey           String         @unique
  ingestUrl           String
  status              StreamStatus   @default(OFFLINE)
  monetizationType    String         @default("free") // free, paid, subscription
  accessPrice         Int?           // cents
  accessCurrency      String         @default("EUR")
  subscriptionMonthlyPrice  Int?
  subscriptionYearlyPrice   Int?
  thumbnailUrl        String?
  isPublic            Boolean        @default(true)
  recordingEnabled    Boolean        @default(true)
  viewerCount         Int            @default(0)
  currentBitrate      Int?
  currentFps          Int?
  currentLatency      Int?
  lastHealthCheck     DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  scheduledFor        DateTime?
  archivedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  recordings          StreamRecording[]
  chatMessages        StreamChatMessage[]
  chatReactions       StreamChatReaction[]
  viewers             StreamViewer[]
  moderators          StreamModerator[]
  donations           StreamDonation[]
  superChats          StreamSuperChat[]
  accessTransactions  StreamAccessTransaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([viewerCount])
}

model StreamRecording {
  id              String          @id @default(cuid())
  streamId        String
  stream          LiveStream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  thumbnailUrl    String?
  duration        Int
  status          RecordingStatus @default(PROCESSING)
  hlsUrl          String?
  dashUrl         String?
  recordedAt      DateTime
  completedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())

  clips           StreamClip[]
  views           StreamRecordingView[]

  @@index([streamId])
  @@index([status])
}

model StreamClip {
  id              String          @id @default(cuid())
  recordingId     String
  recording       StreamRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startTime       Int
  endTime         Int
  duration        Int
  hlsUrl          String
  dashUrl         String
  status          String          @default("completed")
  createdAt       DateTime        @default(now())

  @@index([recordingId])
}

model StreamChatMessage {
  id              String          @id @default(cuid())
  streamId        String
  stream          LiveStream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("StreamChat", fields: [userId], references: [id], onDelete: Cascade)
  message         String
  deleted         Boolean         @default(false)
  timestamp       DateTime        @default(now())

  reactions       StreamChatReaction[]

  @@index([streamId])
  @@index([userId])
  @@index([timestamp])
}

model StreamChatReaction {
  id              String          @id @default(cuid())
  messageId       String
  message         StreamChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji           String
  userId          String
  user            User            @relation("StreamReaction", fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model StreamViewer {
  id              String          @id @default(cuid())
  streamId        String
  stream          LiveStream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("StreamViewers", fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  location        String?
  deviceType      String          @default("desktop")

  @@index([streamId])
  @@index([userId])
}

model StreamModerator {
  id              String          @id @default(cuid())
  streamId        String
  stream          LiveStream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("StreamModeration", fields: [userId], references: [id], onDelete: Cascade)
  action          String          // ban, timeout, mute
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())

  @@index([streamId])
  @@index([userId])
}

model StreamDonation {
  id              String          @id @default(cuid())
  streamId        String
  stream          LiveStream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("StreamDonations", fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  message         String?
  stripePaymentId String?
  status          String          @default("pending")
  createdAt       DateTime        @default(now())

  @@index([streamId])
  @@index([userId])
}

model StreamSuperChat {
  id              String          @id @default(cuid())
  streamId        String
  stream          LiveStream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("StreamSuperChats", fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  message         String
  stripePaymentId String?
  status          String          @default("pending")
  pinnedAt        DateTime?
  createdAt       DateTime        @default(now())

  @@index([streamId])
  @@index([userId])
}

model StreamAccessTransaction {
  id              String          @id @default(cuid())
  streamId        String
  stream          LiveStream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("StreamAccess", fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  type            String          // access_fee, subscription
  status          String          @default("pending")
  createdAt       DateTime        @default(now())

  @@index([streamId])
  @@index([userId])
}

model StreamRecordingView {
  id              String          @id @default(cuid())
  recordingId     String
  recording       StreamRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("StreamRecordingViews", fields: [userId], references: [id], onDelete: Cascade)
  watchTime       Int
  viewedAt        DateTime        @default(now())

  @@index([recordingId])
  @@index([userId])
}

model StreamerPayout {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation("StreamerPayouts", fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  stripeTransferId String?
  status          String          @default("pending")
  paidAt          DateTime?
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([status])
}

// ===========================================================================
// Integrations
// ===========================================================================

model Integration {
  id              String   @id @default(cuid())
  name            String
  description     String
  category        String   // crm, email, payment, communication, analytics, other
  icon            String
  documentation   String
  requiresAuth    Boolean  @default(true)
  active          Boolean  @default(true)
  ratingCount     Int      @default(0)
  averageRating   Float    @default(0)

  userIntegrations UserIntegration[]
  webhooks        Webhook[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@index([averageRating])
}

model UserIntegration {
  id              String   @id @default(cuid())
  userId          String
  integrationId   String
  configuration   Json
  status          String   // ACTIVE, INACTIVE, ERROR
  accessToken     String?
  refreshToken    String?
  tokenExpiry     DateTime?
  uninstalledAt   DateTime?

  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, integrationId])
  @@index([userId])
  @@index([integrationId])
  @@index([status])
}

model Webhook {
  id              String   @id @default(cuid())
  integrationId   String
  url             String
  events          String[] // JSON array
  secret          String
  retryAttempts   Int      @default(3)
  active          Boolean  @default(true)

  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  logs            WebhookLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([integrationId])
  @@index([active])
}

model WebhookLog {
  id              String   @id @default(cuid())
  webhookId       String
  event           String
  status          String   // SUCCESS, FAILED
  statusCode      Int
  payload         Json
  response        String?

  webhook         Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([webhookId])
  @@index([status])
  @@index([createdAt])
}

model IntegrationError {
  id              String   @id @default(cuid())
  integrationId   String
  errorMessage    String
  errorCode       String?
  metadata        Json?

  createdAt       DateTime @default(now())

  @@index([integrationId])
  @@index([createdAt])
}
