{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:with-migrate",
  "crons": [
    {
      "path": "/api/internal/matching/tick",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/active-hours/recompute",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/internal/orchestration/tick",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/internal/rag/reindex",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/internal/sales/tick",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/ai/watchdog",
      "schedule": "0 7 * * *"
    }
  ]
}
