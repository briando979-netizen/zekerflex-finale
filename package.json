{
  "name": "zekerflex-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ZekerFlex - Next-Gen Freelance & Work-Force Management Platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:reset": "prisma db seed -- --reset",
    "db:demo-shifts": "node scripts/demo-shifts.mjs",
    "db:demo-shifts:clear": "node scripts/demo-shifts.mjs --clear",
    "vapid:keys": "node scripts/vapid-keys.mjs",
    "models": "node scripts/setup-models.mjs",
    "launch": "node scripts/launch.mjs",
    "daemon": "node scripts/daemon.mjs",
    "test": "vitest run",
    "whisper": "node scripts/whisper.mjs",
    "services": "docker compose up -d mailpit whisper",
    "gen:secrets": "node deploy/scripts/gen-secrets.mjs",
    "deploy": "bash deploy/scripts/deploy.sh",
    "backup": "bash deploy/scripts/backup.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "firebase-admin": "^12.4.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.7.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.6.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.45",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
