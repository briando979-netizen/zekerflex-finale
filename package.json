{
  "name": "zekerflex-platform",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "ZekerFlex - Next-Gen Freelance & Work-Force Management Platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:reset": "prisma db seed -- --reset",
    "db:demo-shifts": "node scripts/demo-shifts.mjs",
    "db:demo-shifts:clear": "node scripts/demo-shifts.mjs --clear",
    "vapid:keys": "node scripts/vapid-keys.mjs",
    "models": "node scripts/setup-models.mjs",
    "launch": "node scripts/launch.mjs",
    "daemon": "node scripts/daemon.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test a11y",
    "loadtest": "node scripts/loadtest.mjs",
    "whisper": "node scripts/whisper.mjs",
    "services": "docker compose up -d mailpit whisper",
    "gen:secrets": "node deploy/scripts/gen-secrets.mjs",
    "deploy": "bash deploy/scripts/deploy.sh",
    "backup": "bash deploy/scripts/backup.sh",
    "build:with-migrate": "prisma generate && prisma migrate deploy && next build"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.7.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.6.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.28",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "hyperid": { "uuid": "^11.1.0" }
  }
}
